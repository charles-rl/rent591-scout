10個月"}, {"key": "degree", "name": "學生/上班族"}, {"key": "pet", "name": "不可養寵物"}, {"key": "cook", "name": "不可開伙"}]}, "preference": {"title": "優選理由", "active": 1, "footnote": "還有3個選擇本房的理由", "data": [{"id": 1, "name": "產權有保障", "text": "已在地政局辦理建物產權登記，選擇更安心", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_01.png"}, {"id": 2, "name": "屋主直租", "text": "屋主本人發佈，減少中間人干預，無需服務費", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_02.png"}, {"id": 3, "name": "拎包入住", "text": "滿足90%的日常所需設備，享輕鬆入住體驗", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_03.png"}, {"id": 4, "name": "7日上新", "text": "21分鐘前發佈，租到概率高", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_04.png"}, {"id": 6, "name": "租金低", "text": "比同社區同格局的房屋，租金低約1793元", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_06.png"}, {"id": 8, "name": "超棒生活機能", "text": "周邊有百貨公司/傳統市場/公園綠地/醫療機構/學校", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_08.png"}]}, "remark": {"title": "屋主說", "key": "remark", "active": 1, "content": "<b>特色說明<br /><br /><span style=\"color:#009900;\">如果你正在尋找適合的居住的環境，或是想換個居住環境</span><br /><br /><span style=\"color:#009900;\">這裡絶對是您最佳的選擇。</span><br /><br /><span style=\"color:#009900;\">這不只是睡覺的地方,而是一個身心可以完全放鬆的地方!!</span><br /><br /><span style=\"color:#009900;\">★</span><span style=\"color:#009900;\">優雅、舒適、安全套房出租</span>&nbsp;<span style=\"color:#009900;\">★</span><br /><br /></b><br /><br /><span style=\"color:#009900;\"><b>★環境/</b></span><span style=\"color:#009900;\"><b>交通概述：</b></span>居住環境單純、鬧中取靜，生活機能佳，臨近公園、有7-11、小歇、85度C、全聯福利中心、頂好超市、傳統市場、各式餐飲小吃店、早餐店、藥妝店.....等等。近劍潭捷運站、士林捷運站、士林夜市、士林運動中心、科博館.......，上班往返台北各商業區交通便利<b>。</b><br /><br />★<b>位大南路與福港街口、生活機能特佳、7-11就在巷口、鄰近士林運動中心、&nbsp;B&amp;amp;Q及前港公園千坪休閒綠地公園，是一個適合居住的美好空間。</b><br /><br />★<b>福港街靜巷一樓，不用爬樓梯&nbsp;。</b><br />★<b>漂亮裝潢、格局方正、水泥隔間、對外窗，房間格局方正舒適<span style=\"color:#009900;\">。</span></b>&nbsp;<br />★<b>居住安全又舒適：明亮寬敞室內走道、高級硫化銅門、滅火器&nbsp;、監視攝影設備</b>。<br /><br />★<b>個人設備配備齊全〈</b>奇美液晶電視<b>、</b>東元單門冰箱<b>、</b>室內電話機<b>、</b>日立分離式冷氣<b>、</b>快煮壺〉，<b>該有的一樣不缺&nbsp;</b>，<b>讓您輕鬆搬&nbsp;、輕鬆入住。</b><br /><br />★<b>免費提供共用設備</b>：洗衣機、室外遮雨棚晾衣間&nbsp;。<br />★月租金包含<b>水費、第四台、6</b>0M<b>寬頻網路、共同區域電費<span style=\"color:#000000;\">。</span><br /><br /></b>★電費<b>：</b>獨立電表，用多少算多少。<br /><br />★<b>其他&nbsp;：</b>為保持清潔，走廊禁止擺鞋子及鞋櫃。室內禁菸，禁養寵物，無炊。<br /><br />◎◎◎<b>歡迎喜好寧靜未養寵物，重視生活品質的朋友進駐。</b>◎◎◎<br />◎◎◎請先預約，<b>看屋預約專線:&nbsp;0972159528</b>古小姐<b>。</b>◎◎◎<br /><br />附近地標：台北富邦銀行、新光銀行、7-11、85度C、全聯福利中心、福港派出所\r\n附近有便利商店、傳統市場、百貨公司、公園綠地、學校、醫療機構、夜市。\r\n本房屋近士林及劍潭捷運站。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "士林區福港街", "lat": "25.0892300", "lng": "121.5186270", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "bus", "name": "後港里站", "distance": 38, "distanceTxt": "距房屋約38公尺"}, {"type": "bus", "name": "福港街站", "distance": 102, "distanceTxt": "距房屋約102公尺"}, {"type": "bus", "name": "承德路四段站", "distance": 109, "distanceTxt": "距房屋約109公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "shop", "name": "貝谷樂企業行", "distance": 503, "distanceTxt": "距房屋約503公尺"}, {"type": "restaurant", "name": "LA JOIE CAFE", "distance": 33, "distanceTxt": "距房屋約33公尺"}]}, {"name": "教育", "key": "education", "children": [{"type": "secondary", "name": "臺北市立陽明高級中學", "distance": 327, "distanceTxt": "距房屋約327公尺"}, {"type": "primary", "name": "臺北市士林區百齡國民小學", "distance": 362, "distanceTxt": "距房屋約362公尺"}]}]}, "cost": {"title": "費用詳情", "active": 1, "data": [{"name": "租金", "value": "10,000元/月", "key": "rentPrice"}, {"name": "押金", "value": "二個月", "key": "deposit"}, {"name": "車位租金", "value": "費用另計", "key": "carportPrice"}, {"name": "租金含", "value": "水費、網路、第四台、清潔費", "key": "priceContainText"}]}, "information": {"title": "基礎資料", "active": 1, "data": [{"name": "產權登記", "value": "房屋已辦產權登記", "key": "hasCertificate", "alias": "", "cate": 1}, {"name": "法定用途", "value": "住家用", "key": "purpose", "alias": "", "cate": 2}, {"name": "可使用面積", "value": "7坪", "key": "area", "alias": "", "cate": 1}, {"name": "建物面積", "value": "24.02坪", "key":