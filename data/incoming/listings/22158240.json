, "help": "", "alias": ""}]}, "service": {"title": "提供設備", "active": 1, "facility": [{"key": "fridge", "active": 1, "name": "冰箱"}, {"key": "washer", "active": 1, "name": "洗衣機"}, {"key": "tv", "active": 1, "name": "電視"}, {"key": "cold", "active": 1, "name": "冷氣"}, {"key": "heater", "active": 1, "name": "熱水器"}, {"key": "bed", "active": 1, "name": "床"}, {"key": "closet", "active": 1, "name": "衣櫃"}, {"key": "fourth", "active": 1, "name": "第四台"}, {"key": "net", "active": 1, "name": "網路"}, {"key": "gas", "active": 1, "name": "天然瓦斯"}, {"key": "sofa", "active": 1, "name": "沙發"}, {"key": "table_chairs", "active": 1, "name": "桌椅"}, {"key": "balcony", "active": 1, "name": "陽台"}, {"key": "lift", "active": 0, "name": "電梯"}, {"key": "park", "active": 0, "name": "車位"}], "notice": [{"key": "leaseTime", "name": "最短1個月"}, {"key": "degree", "name": "學生/上班族"}, {"key": "pet", "name": "不可養寵物"}]}, "preference": {"title": "優選理由", "active": 0, "footnote": "", "data": []}, "remark": {"title": "屋主說", "key": "remark", "active": 1, "content": "<p dir=\"auto\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">If&nbsp;you&nbsp;are&nbsp;looking&nbsp;for&nbsp;a&nbsp;long&nbsp;term/short&nbsp;term&nbsp;accomadation…&nbsp;</span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">套房招租中</span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">男生宿舍房招租中&nbsp;</span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">No&nbsp;deposit,&nbsp;you&nbsp;can&nbsp;rent&nbsp;from&nbsp;one&nbsp;month&nbsp;with&nbsp;kitchen&nbsp;and&nbsp;living&nbsp;room&nbsp;include&nbsp;electric/water/gas/WIFI/&nbsp;TV</span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">&nbsp;一個月起即可租，免押金，含客廳廚房，含水電網瓦倒垃圾</span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">Location:&nbsp;Near&nbsp;Yuanshan(圓山)&nbsp;station&nbsp;Exit&nbsp;1,&nbsp;about&nbsp;4-Minute&nbsp;walk,&nbsp;1-Minute&nbsp;walk&nbsp;to&nbsp;Dalong&nbsp;night&nbsp;market&nbsp;地點：位於圓山捷運站旁，步行大約4分鐘，1分鐘抵達大龍夜市&nbsp;</span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">1人獨立套房，12500(招租中)&nbsp;(租期小於兩個月+1000)&nbsp;private&nbsp;room&nbsp;and&nbsp;shower&nbsp;for&nbsp;1&nbsp;12500(less&nbsp;then&nbsp;2&nbsp;month+1000)&nbsp;</span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">宿舍房(2人-7人)&nbsp;</span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">7人男宿，上鋪5500下鋪6000(招租中)&nbsp;7&nbsp;male&nbsp;dorm，top5500&nbsp;buttom6000</span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">4人男宿，上鋪6500下鋪7000(招租中)4&nbsp;male&nbsp;dorm，top6500/bottom7000</span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">6人女宿，上鋪6000下鋪6500&nbsp;6&nbsp;female&nbsp;dorm，top6000/bottom6500</span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">2人女宿，7500/床&nbsp;&nbsp;&nbsp;&nbsp;2&nbsp;female&nbsp;dorm，7500&nbsp;per&nbsp;bed&nbsp;</span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">公共區域：冷氣、MOD、置物櫃、簡易廚房(冰箱、電磁爐、微波爐、小烤箱等)&nbsp;投幣式洗衣機、投幣式烘衣機、脫水機、電熨斗、吸塵器&nbsp;　&nbsp;無須支付押金，一個月以上即可月租，付款後即可入住，續約請於前期合約結束前14天付款&nbsp;</span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">租金包括：管理費、水電費、網路費&nbsp;禁止寵物、禁止吸菸、禁止未成年&nbsp;</span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">Monthly&nbsp;rent&nbsp;for&nbsp;at&nbsp;lease&nbsp;staying&nbsp;30&nbsp;days.&nbsp;If&nbsp;you&nbsp;want&nbsp;to&nbsp;renew&nbsp;your&nbsp;contract,&nbsp;please&nbsp;pay&nbsp;the&nbsp;rent&nbsp;14&nbsp;days&nbsp;before&nbsp;the&nbsp;new&nbsp;contract.&nbsp;</span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">The&nbsp;rent&nbsp;include&nbsp;management&nbsp;fee,&nbsp;utility&nbsp;bills,&nbsp;and&nbsp;internet&nbsp;fee.&nbsp;</span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">No&nbsp;Pets,&nbsp;no&nbsp;smoking&nbsp;in&nbsp;the&nbsp;house,&nbsp;and&nbsp;the&nbsp;age&nbsp;needs&nbsp;to&nbsp;be&nbsp;over&nbsp;18</span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 15px; color: rgb(8, 8, 9); background-color: rgb(255, 255, 255);\">We&nbsp;provide&nbsp;AC&nbsp;in&nbsp;every&nbsp;rooms.&nbsp;In&nbsp;the&nbsp;public&nbsp;area&nbsp;we&nbsp;have&nbsp;TV、lockers、basic&nbsp;kitchen(fridge\\microwave\\oven\\&nbsp;hot&nbsp;plate\\......)、washing&nbsp;machine&nbsp;and&nbsp;dryer&nbsp;(both&nbsp;are&nbsp;coin-operated)、iron、spin&nbsp;dryer、vacuum&nbsp;and&nbsp;free&nbsp;WIFI,etc.&nbsp;with&nbsp;window&nbsp;or&nbsp;air&nbsp;exchange&nbsp;fan&nbsp;&nbsp;&nbsp;</span></p><p dir=\"auto\"><br><span style=\"font-size: 14px; color: rgb(0, 0, 0);\">附近有便利商店、傳統市場、公園綠地、學校、夜市。</span><br><span style=\"font-size: 14px; color: rgb(0, 0, 0);\">本房屋近庫倫街口公車站、圓山捷運站。</span></p>\r\n附近有便利商店、傳統市場、公園綠地、學校、夜市。\r\