{"name": "隔間材料", "value": "水泥磚牆", "key": "spacematerial", "cate": 2, "help": "", "alias": ""}, {"name": "裝潢信息", "value": "三年內 中檔裝潢", "key": "decorate", "cate": 1, "help": "", "alias": ""}, {"name": "產權登記", "value": "未辦理", "key": "hasCertificate", "cate": 2, "help": "", "alias": ""}, {"name": "屋齡", "value": "-", "key": "age", "cate": 1, "help": "", "alias": ""}]}, "service": {"title": "提供設備", "active": 1, "facility": [{"key": "fridge", "active": 1, "name": "冰箱"}, {"key": "washer", "active": 1, "name": "洗衣機"}, {"key": "tv", "active": 1, "name": "電視"}, {"key": "cold", "active": 1, "name": "冷氣"}, {"key": "heater", "active": 1, "name": "熱水器"}, {"key": "bed", "active": 1, "name": "床"}, {"key": "closet", "active": 1, "name": "衣櫃"}, {"key": "fourth", "active": 1, "name": "第四台"}, {"key": "net", "active": 1, "name": "網路"}, {"key": "gas", "active": 0, "name": "天然瓦斯"}, {"key": "sofa", "active": 1, "name": "沙發"}, {"key": "table_chairs", "active": 1, "name": "桌椅"}, {"key": "balcony", "active": 1, "name": "陽台"}, {"key": "lift", "active": 0, "name": "電梯"}, {"key": "park", "active": 0, "name": "車位"}], "notice": [{"key": "leaseTime", "name": "最短一年"}, {"key": "degree", "name": "上班族"}, {"key": "pet", "name": "不可養寵物"}]}, "preference": {"title": "優選理由", "active": 0, "footnote": "", "data": []}, "remark": {"title": "屋況介紹", "key": "remark", "active": 1, "content": "<p dir=\"auto\"><span style=\"font-size: 13.3333px;\">回家．就是幸福的好所在！</span><br><br><span style=\"font-size: 13.3333px;\">步行三分鐘到汐止站，分租套房，享受汐止最優質的地段</span><br><br><span style=\"font-size: 13.3333px;\">※&nbsp;請加line聯繫:&nbsp;</span><span style=\"font-size: 14px; color: rgb(0, 0, 0);\">@906htetj</span><span style=\"font-size: 13.3333px;\">&nbsp;&nbsp;，回覆比較即時哦！謝謝！</span><br><br><span style=\"font-size: 13.3333px;\">【住的很舒適】</span><br><br><span style=\"font-size: 13.3333px;\">．格局方正，配家具電，採光好</span><br><br><span style=\"font-size: 13.3333px;\">．專用洗衣機，凸窗/陽台曬衣空間</span><br><br><span style=\"font-size: 13.3333px;\">．獨立衛浴</span><br><br><span style=\"font-size: 13.3333px;\">．獨立流理台水槽，可自備黑晶爐炊煮喔！</span><br><br><span style=\"font-size: 13.3333px;\">．紅磚隔音牆--擁有個人最安靜與私密的空間</span><br><br><span style=\"font-size: 13.3333px;\">★家電★</span><br><br><span style=\"font-size: 13.3333px;\">．洗衣機--全自動單槽洗衣機</span><br><br><span style=\"font-size: 13.3333px;\">．43吋壁掛液晶電視--不佔空間</span><br><br><span style=\"font-size: 13.3333px;\">．雙門冰箱--冷藏冷凍雙門冰箱，省電又方便</span><br><br><span style=\"font-size: 13.3333px;\">．分離式冷氣--一能靜、二強冷，三省電</span><br><br><span style=\"font-size: 13.3333px;\">．電熱水器、洗澡水量充足</span><br><br><span style=\"font-size: 13.3333px;\">．每間房8-10個插座，超好用的.&nbsp;</span><br><br><span style=\"font-size: 13.3333px;\">★家具★</span><br><br><span style=\"font-size: 13.3333px;\">．雙人沙發--回家就是享受放鬆的好所在</span><br><br><span style=\"font-size: 13.3333px;\">．大茶几--讓你雙腳自在的靠在桌上</span><br><br><span style=\"font-size: 13.3333px;\">．雙人床組--掀床底下有兩大片的收納空間、全新獨立筒彈簧床</span><br><br><span style=\"font-size: 13.3333px;\">．雙門衣櫃--三層大收納空間</span><br><br><span style=\"font-size: 13.3333px;\">．書桌--上網看書很方便</span><br><br><span style=\"font-size: 13.3333px;\">★生活★</span><br><br><span style=\"font-size: 13.3333px;\">．租金含網路、觀天下第四台、水費，無社區管理費。</span><br><br><span style=\"font-size: 13.3333px;\">．防火建材，備有滅火器及緊急逃生標示，住的安心</span><br><br><span style=\"font-size: 13.3333px;\">．獨立電表--您只需要負擔自己的電費(每度電5.5元)，房東還會告訴你節電小撇步</span><br><br><span style=\"font-size: 13.3333px;\">．專任小管家，每週維護乾淨走道空間</span><br><br><span style=\"font-size: 13.3333px;\">【生活很便利】</span><br><br><span style=\"font-size: 13.3333px;\">吃的喝的➔豐富的各國料理：日式、韓式、義大利、泰國、新加坡…麥當勞、Luisa咖啡、50嵐、窯烤披薩、鐵板燒、拉麵、壽司、涮涮鍋、小火鍋、臭臭鍋&nbsp;，手作茶、麵包烘培店、永和豆漿、雞排、剉冰、鴨肉、牛排、法蘭克肉舖子…應有盡有…繁詳不及列載</span><br><br><span style=\"font-size: 13.3333px;\">商店➔7-11、全家、頂好、美廉社、全聯、燦坤、全國電子、手機快修、家家買(24小時便利購物站，有的沒的生活用品，甚至五金都買的到)，機車行、Gogoro、藥局、眼科，牙科，小兒科、耳鼻喉科，還有數家銀行…還有汐止觀光夜市</span><br><br><span style=\"font-size: 13.3333px;\">全聯、各大便利商店、藥局、各大電信業者、數間銀行</span><br><br><span style=\"font-size: 13.3333px;\">以上是走路二、三分鐘內到的了，再走幾分鐘還可以到傳統市場隨你買菜…</span><br><br><span style=\"font-size: 13.3333px;\">購物➔三分鐘內車程可到U-Town&nbsp;遠雄購物中心、家樂福、五至十分鐘可到Cosco、南港中信園區、南港車站GlobalMall環球購物中心</span><br><br><span style=\"font-size: 13.3333px;\">運動➔下班後想健身，步行三分鐘到8層樓高的汐止運動中心(運動健身一站搞定)，還有萬坪汐止運動公園，在這的大運動場上慢跑或健走吧，讓上班的壓力一掃而空！</span><br><br><span style=\"font-size: 13.3333px;\">【交通很方便】</span><br><br><span style=\"font-size: 13.3333px;\">．台鐵汐止站--步行至汐止站三分鐘</span><br><br><span style=\"font-size: 13.3333px;\">．汐止站有N多台U-bike可騎喔</span><br><br><span style=\"font-size: 13.3333px;\">．公車--新台五路、大同路兩邊公車站牌都能搭，藍15、藍22、311、605、629、668、675…</span><br><br><span style=\"font-size: 13.3333px;\">．高速公路：開車二分鐘上汐止交流道，國一、國三、國五直接通</span><br><br><span style=\"font-size: 13.3333px;\">．快速道路：環東大道速達台北都心</span><br><br><span style=\"font-size: 13.3333px;\">．高鐵：高鐵南港站</span><br><br><span style=\"font-size: 13.3333px;\">【房東的堅持】</span><br><br><span style=\"font-size: 13.3333px;\">為維護本戶居住品質及安全，請配合生活公約，會影響其他房客生活者勿試，過濾房客一直我們所堅持的，不會為了收租金，就隨便亂租。無正常工作，寧可不租。</span><br><br><span style=\"font-size: 13.3333px;\">【歡迎您】</span><br><br><span style=\"font-size: 13.3333px;\">歡迎南軟、汐科工程師、生活單純上班族,&nbsp;拎個皮箱即可</span><br><br><span style=\"font-size: 13.3333px;\">喜愛優質居家好環境，不抽菸、無不良嗜好的您來入住</span><br><br><span style=\"font-size: 13.3333px;\">格局方正大空間，採光好，全新裝潢，你一定會喜歡，在這裏，就是你的幸福空間！</span><br><br><span style=\"font-size: 13.3333px;\">歡迎來電，提早預約看屋時間。</span><br><br><span style=\"font-size: 13.3333px;\">請記得攜帶您的名片或識別證，讓我們更能認識您~</span><br><br>2-505</p>\r\n附近有便利商店、傳統市場、百貨公司、公園綠地、學校、醫療機構、夜市。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "汐止區中正路", "lat": "25.0702790", "lng": "121.6631350", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "bus", "name": "汐止火車站(公園)[新巴士]", "distance": 157, "distanceTxt": "距房屋約157公尺"}, {"type": "bus", "name": "汐止火車站", "distance": 170, "distanceTxt": "距房屋約170公尺"}, {"type": "bus", "name": "汐止火車站(大同路)[新巴士]", "distance": 173, "distanceTxt": "距房屋約173公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "restaurant", "name": "燒肉眾精緻炭火燒肉 汐止大同店", "distance": 20, "distanceTxt": "距房屋約20公尺"