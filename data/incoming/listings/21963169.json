生。</p>\r\n附近有百貨公司。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "三重區永安北路一段66巷7號", "lat": "25.0768000", "lng": "121.4766562", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "bus", "name": "五年千歲[新巴士]站", "distance": 1, "distanceTxt": "距房屋約1公尺"}, {"type": "bus", "name": "和成新村[新巴士]站", "distance": 99, "distanceTxt": "距房屋約99公尺"}, {"type": "bus", "name": "永福國小[新巴士]站", "distance": 282, "distanceTxt": "距房屋約282公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "shop", "name": "橡木桶洋酒蘆洲店", "distance": 552, "distanceTxt": "距房屋約552公尺"}, {"type": "restaurant", "name": "永福街無名麵線", "distance": 126, "distanceTxt": "距房屋約126公尺"}]}, {"name": "教育", "key": "education", "children": [{"type": "primary", "name": "新北市三重區永福國民小學", "distance": 343, "distanceTxt": "距房屋約343公尺"}, {"type": "secondary", "name": "新北市私立徐匯高級中學附設國中部", "distance": 506, "distanceTxt": "距房屋約506公尺"}]}]}, "cost": {"title": "費用詳情", "active": 1, "data": [{"name": "租金", "value": "10,000元/月 (可申請租金補貼)", "key": "rentPrice"}, {"name": "押金", "value": "二個月", "key": "deposit"}, {"name": "電費", "value": "6元/月", "key": "electricFee"}, {"name": "管理費", "value": "無", "key": "manageprice"}, {"name": "租金含", "value": "車位租金、水費、網路、第四台", "key": "priceContainText"}]}, "information": {"title": "基礎資料", "active": 1, "data": [{"name": "產權登記", "value": "房屋已辦產權登記", "key": "hasCertificate", "alias": "", "cate": 1}, {"name": "法定用途", "value": "見使照", "key": "purpose", "alias": "", "cate": 2}, {"name": "可使用面積", "value": "6坪", "key": "area", "alias": "", "cate": 1}, {"name": "屋齡", "value": "55年", "key": "age", "alias": "", "cate": 2}, {"name": "車位", "value": "平面式", "key": "carInfo", "alias": "", "cate": 1}, {"name": "電梯", "value": "無", "key": "lift", "alias": "", "cate": 1}, {"name": "隔間材料", "value": "水泥磚牆", "key": "spacematerial", "alias": "", "cate": 2}, {"name": "裝潢程度", "value": "簡易裝潢", "key": "decorate", "alias": "", "cate": 2}, {"name": "裝潢時間", "value": "三年以上", "key": "decorate_time", "alias": "", "ca