nt/perfer_03.png"}, {"id": 4, "name": "7日上新", "text": "3天前發佈，租到概率高", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_04.png"}, {"id": 5, "name": "出行超便利", "text": "距徐匯中學捷運站 519公尺，通勤/購物都方便", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_05.png"}, {"id": 6, "name": "租金低", "text": "比同社區同格局的房屋，租金低約2004元", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_06.png"}, {"id": 8, "name": "超棒生活機能", "text": "周邊有百貨公司/傳統市場/公園綠地/醫療機構/學校", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_08.png"}]}, "remark": {"title": "屋主說", "key": "remark", "active": 1, "content": "<p>黃金三樓免爬高、傢俱齊全(冰箱、電視、衣櫃、咖啡桌、單人沙發椅等)<br><br>地點：新北市三重區近永福國小、三和國中、徐匯廣場，捷運為中蘆線，非常適合松江南京上班族與北科大學生<br>採光好、生活機能佳，並有寬廣的曬衣空間，附近有公園、永福派出所，安全無虞<br><br>全屋4套房<br><br>Room&nbsp;A&nbsp;:$13,500 **照片如附，可看**<br>Room&nbsp;B:&nbsp;**已出租**<br>Room&nbsp;C&nbsp;**已出租**<br>Room&nbsp;D&nbsp;**已出租**<br>租金內含網路、水費，電費各房有獨立電錶，每度5.5元<br><br>租金第二人+$1500<br><br>※室內全面禁止吸菸，我們提供舒適空間，期盼於外地打拼的你(妳)有家的感覺；<br><br>適合不抽菸、好相處、愛整潔、工作穩定單純上班族者<br><br>看屋請一律來電預約0972-290-708，並帶名片或學生證。</p>\r\n附近有便利商店、傳統市場、百貨公司、公園綠地、學校、醫療機構、夜市。\r\n本房屋近永福國小公車站、三和國中捷運站、徐匯中學捷運站。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "三重區力行路二段136巷", "lat": "25.075836", "lng": "121.4795978", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "subway", "name": "徐匯中學站", "distance": 519, "distanceTxt": "距房屋約519公尺"}, {"type": "bus", "name": "永福街124號[新巴士]站", "distance": 99, "distanceTxt": "距房屋約99公尺"}, {"type": "bus", "name": "永福國小[新巴士]站", "distance": 162, "distanceTxt": "距房屋約162公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "shop", "name": "橡木桶洋酒蘆洲店", "distance": 788, "distanceTxt": "距房屋約788公尺"}, {"type": "restaurant", "name": "湯順淵", "distance": 51, "distanceTxt": "距房屋約51公尺"}]}, {"name": "教育", "key": "education", "children": [{"type": "primary", "name": "新北市三重區永福國民小學", "distance": 135, "distanceTxt": "距房屋約135公尺"}, {"type": "secondary", "name": "新北市私立徐匯高級中學附設國中部", "distance": 490, "distanceTxt": "距房屋約490公尺"}