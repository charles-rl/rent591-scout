rth", "active": 0, "name": "第四台"}, {"key": "net", "active": 0, "name": "網路"}, {"key": "gas", "active": 1, "name": "天然瓦斯"}, {"key": "sofa", "active": 1, "name": "沙發"}, {"key": "table_chairs", "active": 1, "name": "桌椅"}, {"key": "balcony", "active": 1, "name": "陽台"}, {"key": "lift", "active": 0, "name": "電梯"}, {"key": "park", "active": 0, "name": "車位"}], "notice": [{"key": "leaseTime", "name": "最短一年"}, {"key": "pet", "name": "不可養寵物"}]}, "preference": {"title": "優選理由", "active": 0, "footnote": "", "data": []}, "remark": {"title": "屋況介紹", "key": "remark", "active": 1, "content": "<p dir=\"auto\"><span style=\"font-size: 18px;\"><strong>【轉租】已徵得房東同意，<u>與房東重新簽約</u></strong></span></p><p dir=\"auto\"></p><p dir=\"auto\">我住兩年多了(最近剛續兩年約)，這間是我在台北這價位帶租到最好的房子，可惜因工作因素要搬家</p><p dir=\"auto\">南港昆陽站&nbsp;家庭式2房2衛1廳1陽台的&nbsp;<strong><u>1房1衛</u></strong>&nbsp;(自己使用一間乾濕分離浴室)</p><p dir=\"auto\">・只接受單人入住，不可租補、報稅、入籍、寵物</p><p dir=\"auto\">・租約至2028年7月1號，房東同意轉租&nbsp;(如果不想住這麼久，你可以之後再轉租出去)</p><p dir=\"auto\">・起租日&nbsp;11/4起皆可</p><p dir=\"auto\">・租約跟原房東重簽</p><p dir=\"auto\">・主臥室友為一對情侶，人很好相處，當初我們一起租的</p><p dir=\"auto\"></p><p dir=\"auto\"><strong>✅以下是當初我們當初租的原因&nbsp;+&nbsp;個人住了兩年來的心得</strong></p><p dir=\"auto\">・這間原是屋主自住，幾年前重新裝潢過，全屋系統櫃、內裝新、家具齊全，可拎包入住</p><p dir=\"auto\">・你單獨用一間&nbsp;\"乾濕分離\"的衛浴&nbsp;</p><p dir=\"auto\">・房間用氣密窗、日立變頻冷氣、雙人床&nbsp;(個人很討厭非氣密窗的爛窗戶、很吵的窗型冷氣)</p><p dir=\"auto\">・廚房可開伙、陽台陽光直曬能曬衣服</p><p dir=\"auto\">・垃圾車就在樓下路口，下樓出去1分鐘就到</p><p dir=\"auto\">・住宅位在巷弄內並非主幹道旁，晚上很安靜，對外窗太陽直曬進臥室</p><p dir=\"auto\">・水、電、瓦斯&nbsp;都照台水台電帳單繳納，網路我們有自己辦，大家平分</p><p dir=\"auto\"></p><p dir=\"auto\"><strong>交通</strong></p><p dir=\"auto\">・昆陽捷運站步行&nbsp;~7分鐘</p><p dir=\"auto\">・公車站國華新村步行&nbsp;~4分鐘</p><p dir=\"auto\">・公車站修德國小步行&nbsp;~4分鐘</p><p dir=\"auto\">附近許多熱門公車線&nbsp;信義幹線、207、279、281、284、600、817</p><p dir=\"auto\">&nbsp;</p><p dir=\"auto\">-------</p><p dir=\"auto\"></p><p dir=\"auto\">有興趣請來電&nbsp;你/妳的自介&nbsp;(起租日、職業、生活作息...)</p><p dir=\"auto\">我平日得上班，只能晚上或假日看房，不會帶太多組來看</p><p dir=\"auto\">(照片有用AI清除雜物，陽台只拍到一半大小而已，房內除濕機跟電腦椅是我自己的)</p><p dir=\"auto\"></p>\r\n附近有便利商店、傳統市場、公園綠地、學校、醫療機構、夜市。\r\n本房屋近國華新村公車站、修德國小公車站、昆陽捷運站、松山火車站。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "南港區忠孝東路六段278巷1號", "lat": "25.0489989", "lng": "121.5893620", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "subway", "name": "昆陽站", "distance": 424, "distanceTxt": "距房屋約424公尺"}, {"type": "bus", "name": "國華新村站", "distance": 148, "distanceTxt": "距房屋約148公尺"}, {"type": "bus", "name": "陸軍後勤指揮部站", "distance": 169, "distanceTxt": "距房屋約169公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "shop", "name": "玉成新創中心", "distance": 609, "distanceTxt": "距房屋約609公尺"}, {"type": "restaurant", "name": "呷尚寶 元氣店", "distance": 13, "distanceTxt": "距房屋約13公尺"}]}, {"name": "教育", "key": "education", "children": [{"type": "primary", "name": "臺北市南港區成德國民小學", "distance": 329, "distanceTxt": "距房屋約329公尺"}, {"type": "university", "name": "臺北市南港社區大學", "distance": 474, "distanceTxt": "距房屋約474公尺"}]}]}, "cost": {"title": "費用詳情", "active": 1, "data": [{"name": "租金", "value": "16,000元/月", "key": "rentPrice"}, {"name": "水費", "value": "臺水繳費", "key": "waterFee"}, {"name": "押金", "value": "二個月", "key": "deposit"}, {"name": "電費", "value": "臺電繳費", "key": "electricFee"}, {"name": "管理費", "value": "無", "key": "manageprice"}]}, "information": {"title": "基礎資料", "active": 1, "data": [{"name": "產權登記", "value": "房屋已辦產權登記", "key": "hasCertificate", "alias": "", "cate": 1}, {"name": "法定用途", "value": "住家用", "key": "purpose", "alias": "", "cate": 2}, {"name": "可使用面積", "value": "25坪", "key": "area", "alias": "", "cate": 1}, {"name": "建物面積", "value": "31.79坪", "key": "buildArea", "alias": "(不含公設)", "cate": 2}, {"name": "屋齡", "value": "30年", "key": "age", "alias": "", "cate": 2}, {"name": "電梯", "value": "無", "key": "lift", "alias": "", "cate": 1}, {"name": "裝潢程度", "value": "高檔裝潢", "key": "decorate", "alias": "", "cate": 2}, {"name": "陽台", "value": "1陽台", "key": "balcony", "alias": "", "cate": 1}, {"name": "裝潢時間", "va