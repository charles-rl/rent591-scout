<br><br>若是周末無聊想逛街，約走10-15分鐘可抵達徐匯廣場，內為百貨空間。</p>\r\n附近有便利商店、傳統市場、百貨公司、公園綠地、學校、醫療機構。\r\n本房屋近捷運三和國中公車站、建和新村公車站、三和國中捷運站。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "三重區三和路四段117巷", "lat": "25.077638", "lng": "121.485743", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "subway", "name": "三和國中站", "distance": 115, "distanceTxt": "距房屋約115公尺"}, {"type": "bus", "name": "捷運三和國中站", "distance": 66, "distanceTxt": "距房屋約66公尺"}, {"type": "bus", "name": "建和新村站", "distance": 142, "distanceTxt": "距房屋約142公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "shop", "name": "陸地眼鏡 三重店", "distance": 803, "distanceTxt": "距房屋約803公尺"}, {"type": "restaurant", "name": "八方雲集 (三重三和店)", "distance": 25, "distanceTxt": "距房屋約25公尺"}]}, {"name": "教育", "key": "education", "children": [{"type": "university", "name": "三重社區大學", "distance": 174, "distanceTxt": "距房屋約174公尺"}, {"type": "secondary", "name": "新北市三重區三和國民中學", "distance": 247, "distanceTxt": "距房屋約247公尺"}]}]}, "cost": {"title": "費用詳情", "active": 1, "data": [{"name": "租金", "value": "11,000元/月", "key": "rentPrice"}, {"name": "押金", "value": "二個月", "key": "deposit"}, {"name": "電費", "value": "一度 6 元", "key": "electricFee"}, {"name": "租金含", "value": "管理費、水費、網路、第四台", "key": "priceContainText"}]}, "information": {"title": "基礎資料", "active": 1, "data": [{"name": "產權登記", "value": "房屋已辦產權登記", "key": "hasCertificate", "alias": "", "cate": 1}, {"name": "法定用途", "value": "住家用", "key": "purpose", "alias": "", "cate": 2}, {"name": "可使用面積", "value": "8坪", "key": "area", "alias": "", "cate": 1}, {"name": "屋齡", "value": "-", "key": "age", "alias": "", "cate": 2}, {"name": "電梯", "value": "有", "key": "lift", "alias": "", "cate": 1}, {"name": "隔間材料", "value": "水泥磚牆", "key": "spacematerial", "alias": "", "cate": 2}, {"name": "裝潢程度", "value": "簡易裝潢", "key": "decorate", "alias": "", "cate": 2}, {"name": "裝潢時間", "value": "三年以上", "key": "decorate_time", "alias": "", "cate": 2}, {"name": "其他特色", "value": "屋主直租、近捷運、新上架、拎包入住、近