ble_chairs", "active": 1, "name": "桌椅"}, {"key": "balcony", "active": 1, "name": "陽台"}, {"key": "lift", "active": 1, "name": "電梯"}, {"key": "park", "active": 0, "name": "車位"}], "notice": [{"key": "leaseTime", "name": "最短三個月"}, {"key": "degree", "name": "上班族/家庭"}, {"key": "pet", "name": "不可養寵物"}]}, "preference": {"title": "優選理由", "active": 0, "footnote": "", "data": []}, "remark": {"title": "屋況介紹", "key": "remark", "active": 1, "content": "<p dir=\"auto\"><span style=\"font-size: 13.3333px;\">回家．就是幸福的好所在！</span><br><br><span style=\"font-size: 13.3333px;\">步行一分鐘到汐止站，分租套房，享受汐止最優質的地段</span><br><br><span style=\"font-size: 14px; color: rgb(0, 0, 0);\">【聯絡方式】請加Line:@906htetj，回覆會較即時喔！</span><br><br><span style=\"font-size: 13.3333px;\">開放養寵，每月另收500元養寵費。</span><br><br><span style=\"font-size: 13.3333px;\">租期三個月以內，酌收清潔費3000元。</span><br><br><span style=\"font-size: 13.3333px;\">【住的很舒適】</span><br><br><span style=\"font-size: 13.3333px;\">．有電梯，上下樓搬家超輕鬆</span><br><br><span style=\"font-size: 13.3333px;\">．格局方正，配家具電，採光好</span><br><br><span style=\"font-size: 13.3333px;\">．專用洗衣機，陽台曬衣空間</span><br><br><span style=\"font-size: 13.3333px;\">．超大獨立衛浴</span><br><br><span style=\"font-size: 13.3333px;\">．獨立流理台水槽，可自備黑晶爐炊煮喔！</span><br><br><span style=\"font-size: 13.3333px;\">．紅磚及雙面雙層隔音牆--擁有個人最安靜與私密的空間</span><br><br><span style=\"font-size: 13.3333px;\">★家電★</span><br><br><span style=\"font-size: 13.3333px;\">．洗衣機--全自動單槽洗衣機</span><br><br><span style=\"font-size: 13.3333px;\">．43~50吋壁掛液晶電視--不佔空間</span><br><br><span style=\"font-size: 13.3333px;\">．雙門冰箱--冷藏冷凍雙門冰箱，省電又方便</span><br><br><span style=\"font-size: 13.3333px;\">．分離式冷氣--一能靜、二強冷，三省電</span><br><br><span style=\"font-size: 13.3333px;\">．電熱水器、洗澡水量充足</span><br><br><span style=\"font-size: 13.3333px;\">．每間房8-10個插座，超好用的.&nbsp;</span><br><br><span style=\"font-size: 13.3333px;\">★家具★</span><br><br><span style=\"font-size: 13.3333px;\">．雙人沙發--回家就是享受放鬆的好所在</span><br><br><span style=\"font-size: 13.3333px;\">．大茶几--讓你雙腳自在的靠在桌上</span><br><br><span style=\"font-size: 13.3333px;\">．雙人床組--掀床底下有兩大片的收納空間、全新獨立筒彈簧床</span><br><br><span style=\"font-size: 13.3333px;\">．雙門衣櫃--三層大收納空間</span><br><br><span style=\"font-size: 13.3333px;\">．書桌--上網看書很方便</span><br><br><span style=\"font-size: 13.3333px;\">★生活★</span><br><br><span style=\"font-size: 13.3333px;\">．租金含網路、觀天下第四台，無社區管理費。</span><br><br><span style=\"font-size: 13.3333px;\">．防火建材，備有滅火器及緊急逃生標示，住的安心</span><br><br><span style=\"font-size: 13.3333px;\">．獨立電表--您只需要負擔自己的電費(每度電5.5元)，房東還會告訴你節電小撇步</span><br><br><span style=\"font-size: 13.3333px;\">．專任小管家，每週維護乾淨走道空間</span><br><br><span style=\"font-size: 13.3333px;\">【生活很便利】</span><br><br><span style=\"font-size: 13.3333px;\">吃的喝的➔豐富的各國料理：日式、韓式、義大利、泰國、新加坡…麥當勞、Luisa咖啡、50嵐、窯烤披薩、鐵板燒、拉麵、壽司、涮涮鍋、小火鍋、臭臭鍋&nbsp;，手作茶、麵包烘培店、永和豆漿、雞排、剉冰、鴨肉、牛排、法蘭克肉舖子…應有盡有…繁詳不及列載</span><br><br><span style=\"font-size: 13.3333px;\">商店➔7-11、全家、頂好、美廉社、全聯、燦坤、全國電子、手機快修、家家買(24小時便利購物站，有的沒的生活用品，甚至五金都買的到)，機車行、Gogoro、藥局、眼科，牙科，小兒科、耳鼻喉科，還有數家銀行…還有汐止觀光夜市</span><br><br><span style=\"font-size: 13.3333px;\">全聯、各大便利商店、藥局、各大電信業者、數間銀行</span><br><br><span style=\"font-size: 13.3333px;\">以上是走路二、三分鐘內到的了，再走幾分鐘還可以到傳統市場隨你買菜…</span><br><br><span style=\"font-size: 13.3333px;\">購物➔三分鐘內車程可到U-Town&nbsp;遠雄購物中心、家樂福、五至十分鐘可到Cosco、南港中信園區、南港車站GlobalMall環球購物中心</span><br><br><span style=\"font-size: 13.3333px;\">運動➔下班後想健身，步行三分鐘到8層樓高的汐止運動中心(運動健身一站搞定)，還有萬坪汐止運動公園，在這的大運動場上慢跑或健走吧，讓上班的壓力一掃而空！</span><br><br><span style=\"font-size: 13.3333px;\">【交通很方便】</span><br><br><span style=\"font-size: 13.3333px;\">．台鐵汐止站--步行至汐止站一分鐘</span><br><br><span style=\"font-size: 13.3333px;\">．汐止站有N多台U-bike可騎喔</span><br><br><span style=\"font-size: 13.3333px;\">．公車--新台五路、大同路兩邊公車站牌都能搭，藍15、藍22、311、605、629、668、675…</span><br><br><span style=\"font-size: 13.3333px;\">．高速公路：開車二分鐘上汐止交流道，國一、國三、國五直接通</span><br><br><span style=\"font-size: 13.3333px;\">．快速道路：環東大道速達台北都心</span><br><br><span style=\"font-size: 13.3333px;\">．高鐵：高鐵南港站</span><br><br><span style=\"font-size: 13.3333px;\">【房東的堅持】</span><br><br><span style=\"font-size: 13.3333px;\">為維護本戶居住品質及安全，請配合生活公約，會影響其他房客生活者勿試，過濾房客一直我們所堅持的，不會為了收租金，就隨便亂租。無正常工作，寧可不租。</span><br><br><span style=\"font-size: 13.3333px;\">【歡迎您】</span><br><br><span style=\"font-size: 13.3333px;\">歡迎南軟、汐科工程師、生活單純上班族,&nbsp;拎個皮箱即可</span><br><br><span style=\"font-size: 13.3333px;\">喜愛優質居家好環境，不抽菸、無不良嗜好的您來入住</span><br><br><span style=\"font-size: 13.3333px;\">格局方正大空間，採光好，全新裝潢，你一定會喜歡，在這裏，就是你的幸福空間！</span><br><br><span style=\"font-size: 13.3333px;\">歡迎來電，提早預約看屋時間！。</span><br><br><span style=\"font-size: 13.3333px;\">請記得攜帶您的名片或識別證，讓我們更能認識您！</span></p><p dir=\"auto\"></p><p dir=\"auto\">524-306</p>\r\n附近有便利商店、傳統市場、公園綠地、學校、醫療機構、夜市。\r\n本房屋近汐止車站公車站、汐科車站火車站。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "汐止區大同路二段524號", "lat": "25.0684650", "lng": "121.6612860", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "bus", "name": "汐止車站", "distance": 49, "distanceTxt": "距房屋約49公尺"}, {"type": "bus", "name": "汐止站", "distance": 85, "distanceTxt": "距房屋約85公尺"}, {"type": "bus", "name": "汐止火車站(寶島眼鏡行)[新巴士]", "distance": 92, "distanceTxt": "距房屋約92公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "restaurant", "name": "永和豆漿", "distance": 33, "distanceTxt": "距房屋約33公尺"}, {"type": "shop", "name": "Happy - 黑皮選物販賣、娃娃機", "distance": 494, "distanceTxt": "距房屋約494公尺"}]}, {"name": "教育", "key": "education", "children": [{"type": "secondary", "name": "新北市立秀峰高級中學", "distance": 302, "distanceTxt": "距房屋約302公尺"}, {"type": "primary", "name": "新北市汐止區秀峰國民小學", "distance": 622, "distanceTxt": "距房屋約622公尺"}]}]}, "cost": {"title": "費用詳情", "active": 1, "data": [{"name": "租金", "value": "15,000元/月", "key": "rentPrice"}, {"name": "水費", "value": "每人每月200元", "key": "waterFee"}, {"name": "押金", "value": "二個月", "key": "deposit"}, {"name": "電費", "value": "每度5.5元", "key": "electricFee"}, {"name": "管理費", "value": "無", "key": "manageprice"}, {"name": "租金含", "value": "網路、第四台", "key": "priceContainText"}]}, "information": {"title": "基礎資料", "active": 1, "data": [{"name": "產權登記", "