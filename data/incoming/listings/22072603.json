px;\"><b>*仲介勿擾</b></span>\r\n附近有便利商店、傳統市場、百貨公司、公園綠地、學校、醫療機構、夜市。\r\n本房屋近大橋頭捷運站。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "大同區重慶北路三段", "lat": "25.0650801", "lng": "121.511761", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "subway", "name": "大橋頭站", "distance": 290, "distanceTxt": "距房屋約290公尺"}, {"type": "bus", "name": "延三觀光夜市站", "distance": 104, "distanceTxt": "距房屋約104公尺"}, {"type": "bus", "name": "延平國小站", "distance": 149, "distanceTxt": "距房屋約149公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "shop", "name": "美安SHOP.COM經銷商 民權西路", "distance": 895, "distanceTxt": "距房屋約895公尺"}, {"type": "restaurant", "name": "老殿羊肉爐", "distance": 57, "distanceTxt": "距房屋約57公尺"}]}, {"name": "教育", "key": "education", "children": [{"type": "primary", "name": "臺北市大同區延平國民小學（臨時校舍）", "distance": 182, "distanceTxt": "距房屋約182公尺"}, {"type": "secondary", "name": "臺北市立民權國中", "distance": 259, "distanceTxt": "距房屋約259公尺"}]}]}, "cost": {"title": "費用詳情", "active": 1, "data": [{"name": "租金", "value": "15,500元/月", "key": "rentPrice"}, {"name": "押金", "value": "二個月", "key": "deposit"}, {"name": "管理費", "value": "無", "key": "manageprice"}, {"name": "租金含", "value": "網路、第四台", "key": "priceContainText"}]}, "information": {"title": "基礎資料", "active": 1, "data": [{"name": "產權登記", "value": "房屋已辦產權登記", "key": "hasCertificate", "alias": "", "cate": 1}, {"name": "法定用途", "value": "見使照", "key": "purpose", "alias": "", "cate": 2}, {"name": "可使用面積", "value": "12坪", "key": "area", "alias": "", "cate": 1}, {"name": "建物面積", "value": "見使照", "key": "buildArea", "alias": "", "cate": 2}, {"name": "屋齡", "value": "-", "key": "age", "alias": "", "cate": 2}, {"name": "電梯", "value": "無", "key": "lift", "alias": "", "cate": 1}, {"name": "其他特色", "value": "屋主直租、近捷運、新上架、拎包入住、近商圈、隨時可遷入、可開伙、免管理費", "key": "tags", "alias": "", "cate": 2}]}, "linkInfo": {"avatar": "https://images.591.com.tw/index/medium/no-photo-new.png", "chargeTxt": "", "name": "張先生", "role": 1, "roleName": "屋主", "