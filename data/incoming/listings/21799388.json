 [{"key": "leaseTime", "name": "最短一年"}, {"key": "cook", "name": "不可開伙"}]}, "preference": {"title": "優選理由", "active": 0, "footnote": "", "data": []}, "remark": {"title": "屋況介紹", "key": "remark", "active": 1, "content": "<p dir=\"auto\"><span style=\"font-size: 18px;\">⭐可寵質感套房出租⭐</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">💟位於蘆洲長安街，近忠義廟商圈，美食超.級.多！早餐店、便利商店、蝦皮店到店、郵局、康是美、麥當勞、飲料店、公園....應有盡有，種類繁多，生活沒煩惱！</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">💟適合機車族&鐵馬族，騎腳踏車8分鐘到捷運蘆洲站👍&nbsp;下樓一分鐘有ubike，旁邊就是河堤，適合熱愛運動的你/妳！！</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">💟走路3分鐘到公車站，往臺北市、蘆洲、三重....都很方便🎉</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">💟可以養寵物👍</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">🚩租金：$14500 / 月</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">💟樓層：公寓5&nbsp;/&nbsp;5樓（非頂加）</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">💟坪數：一套房，大約坪8</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">💟房間設備：</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">✅獨立對外窗</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">✅獨立陽台，獨洗獨曬</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">✅變頻冷暖氣機</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">✅雙人沙發、茶几</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">✅43吋電視、第四台、100M寬頻</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">✅獨立10公升洗衣機</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">✅流理臺、電磁爐、有冷凍庫的冰箱</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">✅大容量儲熱式電熱水器、乾濕分離衛浴</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">✅除濕機</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">✅獨立筒加大雙人床墊&nbsp;+&nbsp;掀床</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">✅雙門衣櫃</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">💟公共走廊設有飲水機</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">💟住處大門使用專屬感應式磁卡，門外及公共空間走道都有24小時監控設備，讓您住得安心！</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">💟樓下有許多機車停車格和汽車收費停車場，停車沒問題👍</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">💟獨立電表，電費夏季（6至9月）1度6元，非夏季1度5元</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">💟房租含水費、網路費、第四台寬頻費</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">💟無垃圾代收，樓下就有垃圾車經過，一天三個班次</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">💟租期：至少一年</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">💟押金：兩個月</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">租客皆經過篩選，都是工作穩定、生活習慣優良的好租客，歡迎穩定工作上班族、情侶、夫妻等優質房客入住。</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">您尋覓好房東，我們也在尋覓好房客！我們用心對待每位房客，與房客共同打造一個舒適的生活環境，謝絕有生活不良嗜好者哦！</span></p><p dir=\"auto\"><span style=\"font-size: 18px;\">※看房請帶工作識別證或名片※</span></p>\r\n附近有便利商店、傳統市場、百貨公司、公園綠地、學校、夜市。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "蘆洲區長安街267巷", "lat": "25.0832659", "lng": "121.4572890", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "bus", "name": "永德里站", "distance": 59, "distanceTxt": "距房屋約59公尺"}, {"type": "bus", "name": "永康公園站", "distance": 184, "distanceTxt": "距房屋約184公尺"}, {"type": "bus", "name": "長安街一站", "distance": 215, "distanceTxt": "距房屋約215公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "shop", "name": "I KISS Hair Salon", "distance": 1205, "distanceTxt": "距房屋約1205公尺"}, {"type": "restaurant", "name": "宵夜煎餃×燒き餃子（新北市蘆洲店）", "distance": 27, "distanceTxt": "距房屋約27公尺"}]}, {"name": "教育", "key": "education", "children": [{"type": "primary", "name": "新北市蘆洲區成功國民小學", "distance": 268, "distanceTxt": "距房屋約268公尺"}, {"type": "secondary", "name": "新北市立蘆洲國民中學", "distance": 1030, "distanceTxt": "距房屋約1030公尺"}]}]}, "cost": {"title": "費用詳情", "active": 1, "data": [{"name": "租金", "value": "14,500元/月", "key": "rentPrice"}, {"name": "押金", "value": "二個月", "key": "deposit"}, {"name": "服務費", "value": "半個月租金", "key": "serviceFee"}, {"name": "管理費", "value": "無", "key": "manageprice"}, {"name": "租金含", "value": "水費、網路、第四台", "key": "priceContainText"}]}, "informati