，沒收押金。<br><br>*誠摯歡迎電話預約看屋：<br><br>陳太太（屋主）0916-410-933<br><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;0933-713-410<br><br>簽約時請租戶本人攜帶身份證正本+正反面影本</p>\r\n附近有便利商店、傳統市場、百貨公司、公園綠地、學校、醫療機構、夜市。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "三重區重陽路三段", "lat": "25.067758", "lng": "121.489527", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "bus", "name": "修德國小站", "distance": 74, "distanceTxt": "距房屋約74公尺"}, {"type": "bus", "name": "修德國小(三重站)", "distance": 89, "distanceTxt": "距房屋約89公尺"}, {"type": "bus", "name": "六張街口站", "distance": 134, "distanceTxt": "距房屋約134公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "shop", "name": "宏聲菸酒有限公司", "distance": 183, "distanceTxt": "距房屋約183公尺"}, {"type": "restaurant", "name": "番茄村漢堡 三重重陽店", "distance": 19, "distanceTxt": "距房屋約19公尺"}]}, {"name": "教育", "key": "education", "children": [{"type": "primary", "name": "新北市三重區修德國民小學", "distance": 283, "distanceTxt": "距房屋約283公尺"}, {"type": "secondary", "name": "新北市立明志國民中學", "distance": 479, "distanceTxt": "距房屋約479公尺"}]}]}, "cost": {"title": "費用詳情", "active": 1, "data": [{"name": "租金", "value": "13,000元/月", "key": "rentPrice"}, {"name": "押金", "value": "二個月", "key": "deposit"}, {"name": "車位租金", "value": "費用另計", "key": "carportPrice"}, {"name": "租金含", "value": "管理費、水費、網路、第四台、清潔費", "key": "priceContainText"}]}, "information": {"title": "基礎資料", "active": 1, "data": [{"name": "產權登記", "value": "房屋已辦產權登記", "key": "hasCertificate", "alias": "", "cate": 1}, {"name": "法定用途", "value": "住家用", "key": "purpose", "alias": "", "cate": 2}, {"name": "可使用面積", "value": "8坪", "key": "area", "alias": "", "cate": 1}, {"name": "建物面積", "value": "21.18坪", "key": "buildArea", "alias": "(不含公設)", "cate": 2}, {"name": "屋齡", "value": "-", "key": "age", "alias": "", "cate": 2}, {"name": "車位", "value": "平面式", "key": "carInfo", "alias": "", "cate": 1}, {"name": "電梯", "value