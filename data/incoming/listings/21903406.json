y": "hasCertificate", "cate": 1, "help": "", "alias": ""}, {"name": "屋齡", "value": "-", "key": "age", "cate": 2, "help": "", "alias": ""}]}, "service": {"title": "提供設備", "active": 1, "facility": [{"key": "fridge", "active": 1, "name": "冰箱"}, {"key": "washer", "active": 1, "name": "洗衣機"}, {"key": "tv", "active": 0, "name": "電視"}, {"key": "cold", "active": 1, "name": "冷氣"}, {"key": "heater", "active": 1, "name": "熱水器"}, {"key": "bed", "active": 1, "name": "床"}, {"key": "closet", "active": 1, "name": "衣櫃"}, {"key": "fourth", "active": 0, "name": "第四台"}, {"key": "net", "active": 1, "name": "網路"}, {"key": "gas", "active": 0, "name": "天然瓦斯"}, {"key": "sofa", "active": 1, "name": "沙發"}, {"key": "table_chairs", "active": 1, "name": "桌椅"}, {"key": "balcony", "active": 1, "name": "陽台"}, {"key": "lift", "active": 0, "name": "電梯"}, {"key": "park", "active": 0, "name": "車位"}], "notice": [{"key": "leaseTime", "name": "最短一年"}, {"key": "pet", "name": "不可養寵物"}, {"key": "cook", "name": "不可開伙"}]}, "preference": {"title": "優選理由", "active": 0, "footnote": "", "data": []}, "remark": {"title": "屋況介紹", "key": "remark", "active": 1, "content": "<p>低樓層獨立套房•大陽台・獨洗獨曬｜台電計價｜近台藝大、亞東醫院•低樓層</p><p>✨&nbsp;採光舒適｜獨立陽台｜獨立洗衣機｜獨立曬衣空間｜台電計價</p><p>📍&nbsp;地點：新北市板橋區大觀路二段37巷</p><p>想找一間真正有「自己生活空間」的套房，這間很適合你喔</p><p>乾淨衛生自己使用自己房間洗衣機，也不用跟別人搶曬衣服，獨立洗、獨立曬，舒適大陽台；另外採台電費計價，費用清楚透明。</p><p>🏠&nbsp;房屋特色</p><p>・3樓，免爬高樓層</p><p>・獨立陽台，可曬衣、透氣</p><p>・獨立洗衣機</p><p>・獨立曬衣空間</p><p>・台電電費計價</p><p>・室內簡約舒適，適合一人居住</p><p>・生活空間單純，回家就是自己的小天地</p><p>🚇&nbsp;交通方便</p><p>・附近有「中山實小」、「合安一路」等公車站</p><p>・可利用板南線往板橋、台北市區通勤</p><p>・周邊亦可銜接臺鐵浮洲站&nbsp;650公尺</p><p>・近捷運板南線</p><p>🎓&nbsp;學生、上班族都方便</p><p>・國立臺灣藝術大學約400～500公尺</p><p>・新北市板橋區中山國民小學就在附近</p><p>・鄰近亞東醫院生活圈</p><p>・周邊餐飲選擇多，日常吃飯不用跑遠</p><p>🛒&nbsp;生活機能</p><p>・樓下就有便利商店，全家、7-11</p><p>・附近有早餐店、小吃、餐飲</p><p>・鄰近亞東醫院及周邊商圈</p><p>・採買、用餐、交通都方便</p><p>🌿&nbsp;適合喜歡「有陽台、有自己的洗衣空間」的人</p><p>一個人住，不需要太大的房子，但該有的生活機能不能少。</p><p>獨立陽台＋獨洗獨曬＋台電計價，住起來更自在、更單純。</p><p>歡迎預約看房，現場看屋況最準！</p><p></p><p>LineID:@905qjoli</p>"}, "surround": {"title": "周邊配套