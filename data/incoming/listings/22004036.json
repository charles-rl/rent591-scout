": "gas", "active": 0, "name": "天然瓦斯"}, {"key": "sofa", "active": 0, "name": "沙發"}, {"key": "table_chairs", "active": 0, "name": "桌椅"}, {"key": "balcony", "active": 1, "name": "陽台"}, {"key": "lift", "active": 0, "name": "電梯"}, {"key": "park", "active": 0, "name": "車位"}], "notice": [{"key": "leaseTime", "name": "最短一年"}, {"key": "pet", "name": "不可養寵物"}, {"key": "cook", "name": "不可開伙"}]}, "preference": {"title": "優選理由", "active": 1, "footnote": "還有1個選擇本房的理由", "data": [{"id": 1, "name": "產權有保障", "text": "已在地政局辦理建物產權登記，選擇更安心", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_01.png"}, {"id": 2, "name": "屋主直租", "text": "屋主本人發佈，減少中間人干預，無需服務費", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_02.png"}, {"id": 4, "name": "7日上新", "text": "17小時前發佈，租到概率高", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_04.png"}, {"id": 6, "name": "租金低", "text": "比同社區同格局的房屋，租金低約947元", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_06.png"}]}, "remark": {"title": "屋主說", "key": "remark", "active": 1, "content": "<p><span style=\"font-size: 18px;\"><strong>【汐止樟樹｜全新整理・近汐科站｜屋主自租】</strong></span></p><p><span style=\"font-size: 20px;\">看房請加&nbsp;LINE：@318govme</span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">或直接房聊</span></p><p></p><p><span style=\"font-size: 20px;\">位於<strong>汐止樟樹一路生活圈</strong>，近汐科站，</span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">搭火車到南港也很方便，很適合汐科、南港一帶上班族。</span></p><p></p><p><span style=\"font-size: 20px;\">這裡是汐止很成熟的生活圈，</span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">附近便利商店、超市、傳統市場、餐飲小吃都有，</span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">下班買晚餐、採買日用品，走出門就能解決。</span></p><p><span style=\"font-size: 20px;\">房子近期<strong>全新整理完成</strong>，每間房設備齊全、採光明亮。</span></p><p><span style=\"font-size: 20px;\">我們想提供的不只是一間房間，</span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">而是希望在外租屋，也可以住得<strong>乾淨、舒服、有質感</strong>。</span></p><p><span style=\"font-size: 20px;\">每間房都特別配置了<strong>獨立洗脫烘洗衣機</strong>。</span></p><p><span style=\"font-size: 20px;\">住汐止都知道，天氣比較潮濕，遇到連續下雨，衣服真的很難乾&nbsp;😅</span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">所以不用跟別人共用洗衣機，也不用看天氣決定今天能不能洗衣服，<strong>洗完直接烘乾</strong>，這個住久了真的會很有感。</span></p><p></p><p><span style=\"font-size: 20px;\"><strong>照片皆為現場實拍，不是示意圖。</strong></span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">喜歡的話，歡迎直接私訊預約看房&nbsp;😊</span></p><p></p><p><span style=\"font-size: 21px;\"><strong>【開放房型】</strong></span></p><p><span style=\"font-size: 20px;\">🔹&nbsp;Room&nbsp;A｜$10,500 <strong>（租補後&nbsp;$7,300）</strong></span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">🔹&nbsp;Room&nbsp;B｜$14,500 <strong>（租補後&nbsp;$11,300）</strong></span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">🔹&nbsp;Room&nbsp;C｜已保留</span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">🔹&nbsp;Room&nbsp;D｜$10,000 <strong>（租補後&nbsp;$6,800）</strong></span></p><p></p><p><span style=\"font-size: 21px;\"><strong>【房屋資訊】</strong></span></p><p><span style=\"font-size: 20px;\">🔹&nbsp;地址｜新北市汐止區樟樹一路135巷</span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">🔹&nbsp;房型｜1套房＋3雅房</span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">🔹&nbsp;租期｜一年起</span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">🔹&nbsp;押金｜2個月</span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">🔹&nbsp;仲介費｜<strong>屋主自租，免仲介費</strong></span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">🔹&nbsp;房內設備｜冷氣、床架＋床墊、書桌椅、衣櫃</span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">🔹&nbsp;洗衣設備｜<strong>每房獨立洗脫烘洗衣機</strong></span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">🔹&nbsp;公共設備｜冰箱、飲水機、微波爐、餐桌、收納空間</span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">🔹&nbsp;網路｜<strong>房東提供免費網路</strong></span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">🔹&nbsp;水電費｜依帳單由房客分攤</span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">🔹&nbsp;公共區域｜定期清潔</span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">🔹&nbsp;全室禁菸</span></p><p></p><p><span style=\"font-size: 20px;\">適合<strong>汐科、南港上班族</strong>，</span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">也適合外地來汐止工作，想找一個交通方便、可以長期舒服住下來的人。</span></p><p><span style=\"font-size: 20px;\"><strong>全新整理完成，現在開放預約看房。</strong></span><span style=\"font-size: 12px;\"><br></span><span style=\"font-size: 20px;\">📩&nbsp;有興趣歡迎私訊，或加&nbsp;LINE：@318govme</span></p>"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "汐止區樟樹一路135巷", "lat": "25.0614716", "lng": "121.6408050", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "bus", "name": "樟樹二路口[新巴士]站", "distance": 86, "distanceTxt": "距房屋約86公尺"}, {"type": "bus", "name": "聯合報總部站", "distance": 130, "distanceTxt": "距房屋約130公尺"}, {"type": "bus", "name": "樟樹一路口站", "distance": 132, "distanceTxt": "距房屋約132公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "restaurant", "name": "BBQ", "distance": 111, "distanceTxt": "距房屋約111公尺"}, {"type": "shop", "name": "皇兒小舖 實體門市旗艦店", "distance": 413, "distanceTxt": "距房屋約413公尺"}]}, {"name": "教育", "key": "education", "children": [{"type": "primary", "name": "新北市汐止區樟樹國民小學", "distance": 568, "distanceTxt": "距房屋約568公尺"}, {"type": "secondary", "name": "新北市立汐止國民中學", "distance": 1869, "distanceTxt": "距房屋約1869公尺"}]}]}, "cost": {"title": "費用詳情", "active": 1, "data": [{"name": "租金", "value": "10,000元/月 (可申請租金補貼)", "key": "rentPrice"}, {"name": "水費", "value": "平分賬單", "key": "waterFee"}, {"name": "押金", "value": "二個月", "key": "deposit"}, {"name": "電費", "value": "平分賬單", "key": "electric