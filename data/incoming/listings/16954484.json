、公園綠地、學校。\r\n本房屋近新北市議會公車站、江子翠捷運站、新埔捷運站。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "莊敬華園 板橋區莊敬路105巷", "lat": "25.0254290", "lng": "121.4720551", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "subway", "name": "新埔站", "distance": 413, "distanceTxt": "距房屋約413公尺"}, {"type": "subway", "name": "江子翠站", "distance": 632, "distanceTxt": "距房屋約632公尺"}, {"type": "bus", "name": "新北市議會站", "distance": 247, "distanceTxt": "距房屋約247公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "restaurant", "name": "永和黒豆醬", "distance": 1, "distanceTxt": "距房屋約1公尺"}, {"type": "shop", "name": "三猿廣場", "distance": 394, "distanceTxt": "距房屋約394公尺"}]}, {"name": "教育", "key": "education", "children": [{"type": "primary", "name": "莒光國小風雨操場", "distance": 170, "distanceTxt": "距房屋約170公尺"}, {"type": "secondary", "name": "新北市板橋區江翠國民中學", "distance": 527, "distanceTxt": "距房屋約527公尺"}]}]}, "cost": {"title": "費用詳情", "active": 1, "data": [{"name": "租金", "value": "16,000元/月", "key": "rentPrice"}, {"name": "押金", "value": "二個月", "key": "deposit"}, {"name": "電費", "value": "獨立電表", "key": "electricFee"}, {"name": "車位租金", "value": "費用另計", "key": "carportPrice"}, {"name": "租金含", "value": "管理費、水費、網路、第四台、清潔費", "key": "priceContainText"}]}, "information": {"title": "基礎資料", "active": 1, "data": [{"name": "產權登記", "value": "房屋已辦產權登記", "key": "hasCertificate", "alias": "", "cate": 1}, {"name": "法定用途", "value": "住家用", "key": "purpose", "alias": "", "cate": 2}, {"name": "可使用面積", "value": "9坪", "key": "area", "alias": "", "cate": 1}, {"name": "建物面積", "value": "33.51坪", "key": "buildArea", "alias": "(不含公設)", "cate": 2}, {"name": "屋齡", "value": "-", "key": "age", "alias": "", "cate": 2}, {"name": "車位", "value": "平面式", "key": "carInfo", "alias": "", "cate": 1}, {"name": "朝向", "value": "坐北朝南", "key": "direction", "alias": "", "cate": 2}, {"name": "電梯", "value": "無", "key": "lift", "alias": "", "cate": 1}, {"name": "陽台", "value": "1陽台", "key": "balcony", "alias": "", "cate": 1}, {"