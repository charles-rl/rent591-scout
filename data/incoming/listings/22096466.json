ve": 0, "name": "網路"}, {"key": "gas", "active": 0, "name": "天然瓦斯"}, {"key": "sofa", "active": 1, "name": "沙發"}, {"key": "table_chairs", "active": 1, "name": "桌椅"}, {"key": "balcony", "active": 1, "name": "陽台"}, {"key": "lift", "active": 1, "name": "電梯"}, {"key": "park", "active": 0, "name": "車位"}], "notice": [{"key": "leaseTime", "name": "最短一年"}, {"key": "pet", "name": "不可養寵物"}]}, "preference": {"title": "優選理由", "active": 0, "footnote": "", "data": []}, "remark": {"title": "屋況介紹", "key": "remark", "active": 1, "content": "<p dir=\"auto\">物件介紹~~~~~~<br><span style=\"color: rgb(255, 2, 7);\">(影片為即將退租的可愛弟弟發自內心的真心介紹&nbsp;)</span>😍😍😍</p><p dir=\"auto\" style=\"text-align: start;\">(&nbsp;需要提供基本資料及工作名片或工作證)</p><p dir=\"auto\" style=\"text-align: start;\">(承租者須持有台灣級身分證&nbsp;持居留證者無法承租)</p><p dir=\"auto\" style=\"text-align: start;\">(無法提供社宅所需資料者也請勿來電)</p><p dir=\"auto\" style=\"text-align: start;\">(可共住)</p><p dir=\"auto\" style=\"text-align: start;\">【地址】新北市淡水區沙崙路</p><p dir=\"auto\" style=\"text-align: start;\">【類型】電梯大樓/24小時管理</p><p dir=\"auto\" style=\"text-align: start;\">【格局】1大房/1書房/1客廳/1衛浴/1廚房/2陽台</p><p dir=\"auto\" style=\"text-align: start;\">【坪數】25.19坪&nbsp;權狀坪數/主+陽22.64坪/公設坪數2.55坪</p><p dir=\"auto\" style=\"text-align: start;\">【樓層】12/19樓</p><p dir=\"auto\" style=\"text-align: start;\">【租金】$12000</p><p dir=\"auto\" style=\"text-align: start;\">【管理費】$1260</p><p dir=\"auto\" style=\"text-align: start;\">【能源】台水/台電/桶裝瓦斯</p><p dir=\"auto\" style=\"text-align: start;\">【押金】2個月</p><p dir=\"auto\" style=\"text-align: start;\">【特色】電梯大樓/格局方正/採光好/使用空間大/可雙租補</p><p dir=\"auto\" style=\"text-align: start;\">【備註】絕對禁菸/絕對禁燒香奉神/絕對禁寵物只能接受風水魚</p><p dir=\"auto\" style=\"text-align: start;\">須有正當工作(看屋時請提供工作證或名片或公司IG)待業者暫不考慮</p><p dir=\"auto\" style=\"text-align: start;\">以實際現場屋況現況交屋</p><p dir=\"auto\" style=\"text-align: start;\">禮拜一至禮拜六可以來電預約時段帶看</p><p dir=\"auto\" style=\"text-align: start;\">來電時間:早上11:00至下午6:00</p><p dir=\"auto\" style=\"text-align: start;\">禮拜天固定公休&nbsp;勿來電&nbsp;&nbsp;禮拜天固定公休&nbsp;勿來電&nbsp;&nbsp;禮拜天固定公休&nbsp;勿來電&nbsp;</p><p dir=\"auto\" style=\"text-align: start;\">591留言者請留下聯絡電話&nbsp;專員會盡快與您聯繫&nbsp;</p><p dir=\"auto\" style=\"text-align: start;\">未留電話者&nbsp;請自行加入專員LINE&nbsp;並截圖告知&nbsp;感謝</p><p dir=\"auto\" style=\"text-align: start;\">此廣告照片為實際屋況&nbsp;以現況交屋</p><p dir=\"auto\" style=\"text-align: start;\">入住者須有正當工作(請提供名片或工作證)</p><p dir=\"auto\" style=\"text-align: start;\">☎️預約看屋請撥打專員號碼&nbsp;洪小姐&nbsp;0909713137</p><p dir=\"auto\" style=\"text-align: start;\">&nbsp;&nbsp;&nbsp;若專員未接請耐心等候&nbsp;稍後再撥</p><p dir=\"auto\" style=\"text-align: start;\">☎️歡迎房東、房客來電詢問社會住宅相關事宜</p><p dir=\"auto\" style=\"text-align: start;\">☎️誠徵社會住宅業務專員,向高薪挑戰,只要你有心,肯學都歡迎~</p><p dir=\"auto\" style=\"text-align: start;\">⛔️避免遺漏重要訊息，請直接來電詢問或搜尋Line&nbsp;ID:0909713137</p><p dir=\"auto\" style=\"text-align: start;\">————————————————————————————————</p><p dir=\"auto\" style=\"text-align: start;\">⚠️⚠️⚠️請看內文確認是否有符合社會住宅資格⚠️⚠️⚠️</p><p dir=\"auto\" style=\"text-align: start;\">✅已成年.年滿18歲之中華民國國民及國內設有戶籍。</p><p dir=\"auto\" style=\"text-align: start;\">✅未成年.已於安置教養機構或寄養家庭結束安置無法返家。</p><p dir=\"auto\" style=\"text-align: start;\">✅家庭成員平均個人所得59150元/月以下。</p><p dir=\"auto\" style=\"text-align: start;\">✅動產總額479萬及不動產總額675萬以下。</p><p dir=\"auto\" style=\"text-align: start;\">✅申請人為在地服務現任職務之最高職務列等在警正四階或相當於該職</p><p dir=\"auto\" style=\"text-align: start;\">&nbsp;　務列等以下之警消人員得不受所得限制。</p><p dir=\"auto\" style=\"text-align: start;\">✅家庭成員台北.新北.基隆.桃園.均無自有住宅&nbsp;。</p><p dir=\"auto\" style=\"text-align: start;\">※符合資格者，申請前需準備※</p><p dir=\"auto\" style=\"text-align: start;\">1.社會住宅房客申請書</p><p dir=\"auto\" style=\"text-align: start;\">2.申請人國民身分證影本（配偶亦堤供）</p><p dir=\"auto\" style=\"text-align: start;\">3.「全戶」戶籍謄本，申請日前一個月內（夫妻分戶者應另檢具其配偶之戶籍謄本，記事不得省略）（戶政事務所辦理）</p><p dir=\"auto\" style=\"text-align: start;\">4.「全戶」財產清單及所得清單，一個月內（國稅局辦理）</p><p dir=\"auto\" style=\"text-align: start;\">5.若為現職警消人員，需檢附實際於警消機關在職證明文件及現職銓敘部審定函</p><p dir=\"auto\" style=\"text-align: start;\">6.經濟弱勢或社會弱勢相關證明文件</p><p dir=\"auto\" style=\"text-align: start;\">【300億中央擴大租金補貼申請資格】</p><p dir=\"auto\" style=\"text-align: start;\">※300億租金補助試算網站:搜尋300億元中央擴大租金補貼資格檢視※</p><p dir=\"auto\" style=\"text-align: start;\">✅家庭成員全台均無單獨持有自有房屋。</p><p dir=\"auto\" style=\"text-align: start;\">✅家庭成員持有共有房屋且持分合計非全部。</p><p dir=\"auto\" style=\"text-align: start;\">✅家庭成員平均個人所得50700元/月以下。</p><p dir=\"auto\" style=\"text-align: start;\">※&nbsp;第一級租金補貼</p><p dir=\"auto\" style=\"text-align: start;\">1.家庭成員兩人以上，且成員中具有低收入戶身分者。</p><p dir=\"auto\" style=\"text-align: start;\">2.家庭成員三人以上，且成員中具有中低收入戶身分者。</p><p dir=\"auto\" style=\"text-align: start;\">※&nbsp;第二級租金補貼</p><p dir=\"auto\" style=\"text-align: start;\">非屬第一級及第三級條件者。</p><p dir=\"auto\" style=\"text-align: start;\">※&nbsp;第三級租金補貼</p><p dir=\"auto\" style=\"text-align: start;\">家庭成員一人且未滿40歲，並且未具有經濟或社會弱勢身分者。</p><p dir=\"auto\" style=\"text-align: start;\">◎符合下列資格租金補貼再加碼◎</p><p dir=\"auto\" style=\"text-align: start;\">1.單身青年=加碼1.2倍。</p><p dir=\"auto\" style=\"text-align: start;\">{成年未達40歲單身者}</p><p dir=\"auto\" style=\"text-align: start;\">2.社會弱勢=加碼1.2倍。</p><p dir=\"auto\" style=\"text-align: start;\">*特殊境遇家庭。</p><p dir=\"auto\" style=\"text-align: start;\">*於安置教養機構或寄養家庭結束安置無法返家，未滿二十五歲</p><p dir=\"auto\" style=\"text-align: start;\">(限申請人)。</p><p dir=\"auto\" style=\"text-align: start;\">*六十五歲以上者(限申請人)。</p><p dir=\"auto\" style=\"text-align: start;\">*受家庭暴力或性侵害之受害者及其子女。</p><p dir=\"auto\" style=\"text-align: start;\">*身心障礙者。</p><p dir=\"auto\" style=\"text-align: start;\">*感染人類免疫缺乏病毒者或罹患後天免疫缺乏症候群者。</p><p dir=\"auto\" style=\"text-align: start;\">*原住民。</p><p dir=\"auto\" style=\"text-align: start;\">*災民(自行舉證)。</p><p dir=\"auto\" style=\"text-align: start;\">*遊民。</p><p dir=\"auto\" style=\"text-align: start;\">*因懷孕或生育而遭遇困境之未成年人(限申請人)</p><p dir=\"auto\" style=\"text-align: start;\">3.新婚家庭=加碼1.3。</p><p dir=\"auto\" style=\"text-align: start;\">{結婚2年內者}</p><p dir=\"auto\" style=\"text-align: start;\">4.經濟弱勢=加碼1.4倍。</p><p dir=\"auto\" style=\"text-align: start;\">*低收入戶</p><p dir=\"auto\" style=\"text-align: start;\">*中低收入戶</p><p dir=\"auto\" style=\"text-align: start;\">5.育有未成年子女(胎兒)家庭=加碼1.4倍起。</p><p dir=\"auto\" style=\"text-align: start;\">*未成年子女人數:</p><p dir=\"auto\" style=\"text-align: start;\">1人加碼1.4倍</p><p dir=\"auto\" style=\"text-align: start;\">每增加一人再加0.2倍</p><p dir=\"auto\" style=\"text-align: start;\">同時符合二種以上補貼金額加碼身份者，擇高補貼</p><p dir=\"auto\" style=\"text-align: start;\">新北市社會住宅包租代管第5期計畫【公會版】</p><p dir=\"auto\" style=\"text-align: start;\">得標廠商【匯康資產管理有限公司-新北分公司】</p><p dir=\"auto\" style=\"text-align: start;\">📌不動產經紀人:東大偉(93)北市經證字第00003號(換發)</p><p dir=\"auto\" style=\"text-align: start;\">不動產經紀營業員：洪美智&nbsp;(111)登字第427685號</p><p dir=\"auto\" style=\"text-align: start;\">☎️歡迎房東、房客來電詢問社會住宅</p>\r\n附近有便利商店、公園綠地。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "果嶺大道 淡水區沙崙路216巷", "lat": "25.1800579", "lng": "121.4197784", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "bus", "name": "淡江豪景站", "distance": 137, "distanceTxt": "距房屋約137公尺"}, {"type": "bus", "name": "輕軌淡水漁人碼頭站", "distance": 217, "distanceTxt": "距房屋約217公尺"}, {"type": "bus", "name": "淡水漁人碼頭站", "distance": 247, "distanceTxt": "距房屋約247公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "restaurant", "name": "徐氏美食連鎖餐飲工作室", "distance": 126, "distanceTxt": "距房屋約126公尺"}, {"type": "restaurant", "name": "飽堡樂", "distance": 135, "distanceTxt": "距房屋約135公尺"}]}, {"name": "教育", "key": "education", "children": [{"type": "primary", "name": "新北市淡水區天生國民小學", "distance": 512, "distanceTxt": "距房屋約512公尺"}, {"type": "university", "name": "台北海洋科技大學 淡水校區", "distance": 1517, "distanceTxt": "距房屋約1517公尺"}]}]}, "cost": {"title": "費用詳情", "active": 1, "data": [{"name": "租金", "value": "12,000元/月", "key": "rentPrice"}, {"name": "水費", "value": "臺水繳費", "key": "waterFee"}, {"name": "押金", "value": "二個月", "key": "deposit"}, {"name": "電費", "value": "臺電繳費", "key": "electricFee"}, {"name": "服務費", "value": "不收服務費", "key": "serviceFee"}, {"name": "管理費", "va