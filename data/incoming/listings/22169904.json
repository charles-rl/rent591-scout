ourth", "active": 1, "name": "第四台"}, {"key": "net", "active": 1, "name": "網路"}, {"key": "gas", "active": 0, "name": "天然瓦斯"}, {"key": "sofa", "active": 1, "name": "沙發"}, {"key": "table_chairs", "active": 1, "name": "桌椅"}, {"key": "balcony", "active": 0, "name": "陽台"}, {"key": "lift", "active": 0, "name": "電梯"}, {"key": "park", "active": 0, "name": "車位"}], "notice": [{"key": "leaseTime", "name": "最短一年"}]}, "preference": {"title": "優選理由", "active": 1, "footnote": "還有2個選擇本房的理由", "data": [{"id": 1, "name": "產權有保障", "text": "已在地政局辦理建物產權登記，選擇更安心", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_01.png"}, {"id": 3, "name": "拎包入住", "text": "滿足90%的日常所需設備，享輕鬆入住體驗", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_03.png"}, {"id": 4, "name": "7日上新", "text": "4天前發佈，租到概率高", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_04.png"}, {"id": 5, "name": "出行超便利", "text": "距板橋捷運站 455公尺，通勤/購物都方便", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_05.png"}, {"id": 8, "name": "超棒生活機能", "text": "周邊有百貨公司/傳統市場/公園綠地/醫療機構/學校", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_08.png"}]}, "remark": {"title": "屋況介紹", "key": "remark", "active": 1, "content": "<p dir=\"auto\">歡迎來電預約看屋時間<br><br>只要現在馬上預約看屋，簽約後只要換洗衣物即可直接入住！<br><br>設備齊全舒適大套房~讓您可以和好朋友、同學、同事、家人&nbsp;、或是另一半一起用超值的租金，<br><br>享受付裝潢、家具、家電設備，讓您的家居生活有更好的品質~<br><br>鄰文化路、漢生西路、中正路、新海路、新板萬坪都會公園，<br><br>球場!附近街上商店林立，生活機能超方便，購物飲食免煩惱！！<br><br>交通便利，附近就有多路公車站、板橋捷運站走路不用幾分鐘！！<br><br>環境乾淨又明亮通風、有對外窗和冷氣&nbsp;~<br><br>精美浴廁~媲美飯店式等級~<br><br>不只有洗衣機；更有簡易流理台設備，您只需加上電磁爐即可開伙~<br><br>為維護大家的居住、睡眠品質環境及清潔，禁止飼養會吵人的寵物喲~請見諒!!<br><br>適合上班族、單身貴族、情侶、學生居住歡迎直接來電預約看屋~</p><p dir=\"auto\"><span style=\"font-size: 18px; color: rgb(255, 2, 7);\"><strong>相關費用</strong></span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 18px; color: rgb(255, 2, 7);\"><strong>1、水費150元/月</strong></span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 18px; color: rgb(255, 2, 7);\"><strong>2、電費有獨立電錶依台電平均電價計算</strong></span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 18px; color: rgb(255, 2, 7);\"><strong>3、第四台每月250元</strong></span></p><p dir=\"auto\" style=\"text-align: start;\"><span style=\"font-size: 18px; color: rgb(255, 2, 7);\"><strong>4、垃圾須自行處理等待垃圾車</strong></span><br><br><span style=\"font-size: 16px;\">【入住條件】</span><br><span style=\"font-size: 16px;\">1、性別友善，適合單身貴族、上班族、學生、夫妻情侶</span><br><span style=\"font-size: 16px;\">2、穩定正當工作、品行優良好溝通相處</span><br><span style=\"font-size: 16px;\">3、年滿18歲以上，限本國國籍者</span><br><br><span style=\"font-size: 16px;\">【寵物條件】</span><br><span style=\"font-size: 16px;\">1、貓、狗皆可（不會隨意吵鬧為佳，謝絕會吵鬧的）</span><br><span style=\"font-size: 16px;\">2、犬隻中小型以下（需結紮）</span><br><span style=\"font-size: 16px;\">3、不吵鬧不破壞保持整潔無異味</span><br><br><span style=\"font-size: 16px;\">【備註條件】</span><br><span style=\"font-size: 16px;\">※為維護居住生活品質，以下行業及行為恕無法承租（正職、兼職均不可）</span><br><span style=\"font-size: 16px;\">1、直播主、八大行業</span><br><span style=\"font-size: 16px;\">2、色情行業</span><br><span style=\"font-size: 16px;\">3、生活作息不良者</span><br><span style=\"font-size: 16px;\">4、拖延、遲繳租金</span><br><span style=\"font-size: 16px;\">5、賭博、聚眾喧嘩吵鬧、從事非法項目</span><br><span style=\"font-size: 16px;\">6、邋遢、製造髒亂、交友圈複雜</span><br><span style=\"font-size: 16px;\">7、酗酒、抽煙亂丟菸蒂、吃檳榔亂吐檳榔汁、吸毒嗑藥者</span><br><span style=\"font-size: 16px;\">（若發現違法行為一律報警並以違約論處置）</span><br><br><span style=\"font-size: 16px;\">【聯絡時間】</span><br><span style=\"font-size: 16px;\">週一至週日：上午10點至晚上9點</span><br><br><span style=\"font-size: 16px;\">【聯絡方式】</span><br><span style=\"font-size: 16px;\">電話：0927-908-003（代理人顏先生）</span><br><br><span style=\"font-size: 16px;\">#有任何問題請來電或加Line詢問</span><br><span style=\"font-size: 16px;\">#請勿在線上直接預約及詢問</span><br><span style=\"font-size: 16px;\">#誠意出租無誠勿擾歡迎直接來電預約看屋，連絡時間am：10&nbsp;~pm：09</span></p>\r\n附近有便利商店、傳統市場、百貨公司、公園綠地、學校、醫療機構、夜市。\r\n本房屋近多路公車公車站、板橋捷運站、板橋火車站。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "板橋區國光路", "lat": "25.0187607