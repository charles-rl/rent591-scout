</p><p dir=\"auto\"><span style=\"font-size: 12px; color: green;\">社區有警衛保全,&nbsp;刷卡系統進出社區,&nbsp;安全無虞</span></p><p dir=\"auto\"><span style=\"font-size: 12px; color: rgb(255, 51, 204);\">社區有垃圾集中場,&nbsp;24小時可倒垃圾,不用苦等垃圾車</span></p>\r\n附近有便利商店、夜市。\r\n本房屋近碧華國小公車站、徐匯中學捷運站。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "滿面春風 蘆洲區正和街", "lat": "25.0807696", "lng": "121.4683781", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "bus", "name": "正和街58號[新巴士]站", "distance": 82, "distanceTxt": "距房屋約82公尺"}, {"type": "bus", "name": "正和街口[新巴士]站", "distance": 113, "distanceTxt": "距房屋約113公尺"}, {"type": "bus", "name": "正和街口站", "distance": 144, "distanceTxt": "距房屋約144公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "restaurant", "name": "好滋味烤玉米", "distance": 83, "distanceTxt": "距房屋約83公尺"}, {"type": "shop", "name": "鈺昇珠寶銀樓", "distance": 420, "distanceTxt": "距房屋約420公尺"}]}, {"name": "教育", "key": "education", "children": [{"type": "primary", "name": "新北市蘆洲區蘆洲國民小學", "distance": 439, "distanceTxt": "距房屋約439公尺"}, {"type": "university", "name": "輔大大学", "distance": 694, "distanceTxt": "距房屋約694公尺"}]}]}, "cost": {"title": "費用詳情", "active": 1, "data": [{"name": "租金", "value": "15,700元/月", "key": "rentPrice"}, {"name": "押金", "value": "二個月", "key": "deposit"}]}, "information": {"title": "基礎資料", "active": 1, "data": [{"name": "產權登記", "value": "房屋已辦產權登記", "key": "hasCertificate", "alias": "", "cate": 1}, {"name": "法定用途", "value": "見其他登記事項", "key": "purpose", "alias": "", "cate": 2}, {"name": "可使用面積", "value": "7坪", "key": "area", "alias": "", "cate": 1}, {"name": "建物面積", "value": "23.89坪", "key": "buildArea", "alias": "(不含公設)", "cate": 2}, {"name": "屋齡", "value": "-", "key": "age", "alias": "", "cate": 2}, {"name": "電梯", "value": "有", "key": "lift", "alias": "", "cate": 1}, {"name": "陽台", "value": "1陽台", "key": "balcony", "alias": "", "cate": 1}, {"name": "裝潢時間", "value": "三年以上", "key": "decorate_time", "alias": "", "cate": 2}, {"name": "其他特色", "val