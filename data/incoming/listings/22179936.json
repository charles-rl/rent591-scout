tive": 0, "name": "陽台"}, {"key": "lift", "active": 0, "name": "電梯"}, {"key": "park", "active": 0, "name": "車位"}], "notice": [{"key": "leaseTime", "name": "最短一年"}, {"key": "degree", "name": "學生/上班族"}, {"key": "cook", "name": "不可開伙"}]}, "preference": {"title": "優選理由", "active": 1, "footnote": "還有3個選擇本房的理由", "data": [{"id": 1, "name": "產權有保障", "text": "已在地政局辦理建物產權登記，選擇更安心", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_01.png"}, {"id": 2, "name": "屋主直租", "text": "屋主本人發佈，減少中間人干預，無需服務費", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_02.png"}, {"id": 3, "name": "拎包入住", "text": "滿足90%的日常所需設備，享輕鬆入住體驗", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_03.png"}, {"id": 4, "name": "7日上新", "text": "3天前發佈，租到概率高", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_04.png"}, {"id": 5, "name": "出行超便利", "text": "距菜寮捷運站 522公尺，通勤/購物都方便", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_05.png"}, {"id": 6, "name": "租金低", "text": "比同社區同格局的房屋，租金低約3776元", "icon": "https://s.591.com.tw/build/static/app/rent/perfer_06.png"}]}, "remark": {"title": "屋主說", "key": "remark", "active": 1, "content": "<p dir=\"auto\"><span style=\"font-size: 18px; color: rgb(51, 51, 255);\"><strong>近捷運三重菜寮站/鄰近天台正義北路商圈&nbsp;生活機能佳/可貓&nbsp;/女性佳</strong></span><span style=\"font-size: 14px; color: rgb(51, 51, 255);\"><br></span><br><br><span style=\"font-size: 18px; color: rgb(0, 0, 0);\"><strong>＊&nbsp;＊&nbsp;&nbsp;&nbsp;屋主自租，免收仲介費！</strong></span><br><br><span style=\"font-size: 18px; color: rgb(0, 0, 0);\"><strong>＊＊＊&nbsp;寵物友善,&nbsp;可養貓😺~&nbsp;以不破壞家俱為原則。</strong></span><br><br><span style=\"font-size: 18px; color: rgb(0, 0, 0);\"><strong>＊＊＊&nbsp;&nbsp;一層僅三戶、住戶全部經房東篩選過，生活單純素質優，居住環境讓人安心&nbsp;&nbsp;(女性租客的最愛)<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;家具配備一應俱全，室內已聘請專人清潔打掃，拎包即可馬上入住~&nbsp;住的乾淨又舒適。<br><br></strong></span><br><span style=\"font-size: 18px; color: rgb(0, 0, 0);\"><strong>【配備說明】</strong></span><strong><br><br></strong><span style=\"font-size: 18px;\"><strong>＊&nbsp;每個月只要繳租金＋電費　簡單明瞭</strong></span><strong><br></strong><span style=\"font-size: 18px;\"><strong>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;電費全年統一價&nbsp;</strong></span><span style=\"font-size: 18px; color: rgb(51, 51, 255);\"><strong>一度五元</strong></span><span style=\"font-size: 18px;\"><strong>，政府漲電費我們堅持不漲價。</strong></span><strong><br><br></strong><span style=\"font-size: 18px; color: rgb(74, 74, 74);\"><strong>＊&nbsp;</strong></span><span style=\"font-size: 18px; color: rgb(51, 51, 255);\"><strong>租金包含</strong></span><span style=\"font-size: 18px;\"><strong>：免費網路、室內免費WiFi無限上網120M光纖。<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;每個月幫您省下900元網路費<br><br></strong></span><span style=\"font-size: 18px; color: rgb(74, 74, 74);\"><strong>＊</strong></span><span style=\"font-size: 18px; color: rgb(51, 51, 255);\"><strong>&nbsp;租金包含：</strong></span><span style=\"font-size: 18px;\"><strong>第四台每個月500元；<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;生活用水每月幾百元房東全包，&nbsp;&nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;幫大家省荷包。<br><br>＊&nbsp;靜巷內,&nbsp;舒適優質機能佳的生活空間＊</strong></span><strong><br><br></strong><span style=\"font-size: 18px;\"><strong>＊&nbsp;全新彈簧床墊、床架及保潔墊</strong></span><strong>、</strong><span style=\"font-size: 18px;\"><strong>沙發、茶几、32吋LED&nbsp;電視、雙門冰箱、獨立衛浴、衣櫃、電熱水器…等，一應俱全，一卡皮箱就可入住。＊</strong></span><strong><br><br></strong><span style=\"font-size: 18px;\"><strong>＊&nbsp;全室LED省電燈泡，節能環保低電費。</strong></span><strong><br><br></strong><span style=\"font-size: 18px;\"><strong>＊&nbsp;室內採用分離式冷氣</strong></span><strong><br></strong><span style=\"font-size: 18px;\"><strong><br>【居住環境】<br>＊&nbsp;嚴格篩選房客，住的安心又舒服。<br></strong></span><strong><br></strong><span style=\"font-size: 18px;\"><strong>＊&nbsp;近天台正義北路商圈且鄰近忠孝橋、重新橋及台北橋，交通機能超級方便，&nbsp;通勤族最佳選擇。生活交通機能完整。</strong></span><strong><br><br></strong><span style=\"font-size: 18px;\"><strong>＊&nbsp;步行2分鐘就到便利商店,&nbsp;5分鐘到寶雅生活商店,&nbsp;6分鐘到漢堡王及麥當勞，<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;500公尺內餐飲店林立，生活機能佳、生活便利。<br><br>＊&nbsp;&nbsp;步行5分鐘就到三重綜合體育館，運動休閒也很方便。<br><br>＊&nbsp;&nbsp;步行6分鐘即到三重菜寮捷運站，<br></strong></span><strong><br></strong><span style=\"font-size: 18px;\"><strong>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;步行5分鐘至公車站牌，有10幾條公車路線，多一個通勤的選擇。</strong></span><strong><br><br></strong><span style=\"font-size: 18px;\"><strong>【條件限制】</strong></span><strong><br><br></strong><span style=\"font-size: 18px;\"><strong>＊&nbsp;房東嚴格要求住戶生活品質，需有正當職業(學生可另談)；簽約請帶身份證、工作證或名片。<br></strong></span><strong><br></strong><span style=\"font-size: 18px;\"><strong>＊&nbsp;裝潢皆精心設計，室內已全新整理油漆粉刷，<br>&nbsp;&nbsp;&nbsp;&nbsp;房東希望能尋找愛惜房子的租客，不良嗜好及影響其它房客生活者勿擾，能細心愛護房子者優先。</strong></span><strong><br></strong><br><span style=\"font-size: 18px;\"><strong>＊&nbsp;限制條件：吃檳榔、抽煙、賭博、酗酒、八大行業者恕無法承租。</strong></span></p><p dir=\"auto\"></p><p dir=\"auto\"><span style=\"font-size: 18px; color: rgb(0, 0, 0);\"><strong>歡迎來電預約看屋&nbsp;!</strong></span><strong><br><br></strong><span style=\"font-size: 18px; color: rgb(0, 0, 0);\"><strong>廖小姐&nbsp;0928-580280、&nbsp;0936-194147</strong></span><br></p><p dir=\"auto\"></p>\r\n附近有便利商店、傳統市場、公園綠地、學校、醫療機構、夜市。\r\n本房屋近大同北路公車站、菜寮公車站、三重菜寮捷運站。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "三重區大同北路60巷", "lat": "25.0639740", "lng": "121.4938400", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "subway", "name": "菜寮站", "distance": 522, "distanceTxt": "距房屋約522公尺"}, {"type": "bus", "name": "三重運動場站", "distance": 268, "distanceTxt": "距房屋約268公尺"}, {"type": "bus", "name": "大同路口站", "distance": 283, "distanceTxt": "距房屋約283公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "restaurant", "name": "幸福食堂", "distance": 36, "distanceTxt": "距房屋約36公尺"}, {"type": "shop", "name": "動漫選物販賣店", "distance": 356, "distanceTxt": "距房屋約356公尺"}]}, {"name": "教育", "key": "education", "children": [{"type": "primary", "name": "新北市三重區正義國民小學", "distance": 238, "distanceTxt": "距房屋約238公尺"}, {"type": "secondary", "name": "新北市立明志國民中學", "distance": 489, "distanceTxt": "距房屋約489公尺"}]}]}, "cost": {"title": "費用詳情", "active": 1, "data": [{"nam