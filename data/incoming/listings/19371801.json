百人團隊、服務加倍</span></span></span><br /><br /><span style=\"font-family:'微軟正黑體',sans-serif;\"><span style=\"font-size:16px;\">經紀人證照(91)年北市經證字第00650號&nbsp;雷學誠</span></span>\r\n附近有便利商店、傳統市場、百貨公司、公園綠地、學校、醫療機構、夜市。\r\n本房屋近湖光市場公車站、內湖捷運捷運站。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "大杰逸園 內湖區成功路三段", "lat": "25.0795829", "lng": "121.5892819", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "subway", "name": "文德站", "distance": 452, "distanceTxt": "距房屋約452公尺"}, {"type": "bus", "name": "成功路三段站", "distance": 58, "distanceTxt": "距房屋約58公尺"}, {"type": "bus", "name": "內湖高中站", "distance": 114, "distanceTxt": "距房屋約114公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "restaurant", "name": "上饌鍋物", "distance": 66, "distanceTxt": "距房屋約66公尺"}, {"type": "shop", "name": "中華電信", "distance": 64, "distanceTxt": "距房屋約64公尺"}]}, {"name": "教育", "key": "education", "children": [{"type": "secondary", "name": "臺北市私立達人高級中學", "distance": 214, "distanceTxt": "距房屋約214公尺"}, {"type": "university", "name": "國立臺灣戲曲學院內湖校區", "distance": 381, "distanceTxt": "距房屋約381公尺"}]}]}, "cost": {"title": "費用詳情", "active": 1, "data": [{"name": "租金", "value": "13,800元/月 (可申請租金補貼)", "key": "rentPrice"}, {"name": "押金", "value": "二個月租金", "key": "deposit"}, {"name": "服務費", "value": "半個月租金", "key": "serviceFee"}, {"name": "管理費", "value": "600元/月", "key": "manageprice"}, {"name": "租金含", "value": "水費、網路、第四台", "key": "priceContainText"}]}, "information": {"title": "基礎資料", "active": 1, "data": [{"name": "產權登記", "value": "房屋已辦產權登記", "key": "hasCertificate", "alias": "", "cate": 1}, {"name": "法定用途", "value": "住家用", "key": "purpose", "alias": "", "cate": 2}, {"name": "可使用面積", "value": "8.5坪", "key": "area", "alias": "", "cate": 1}, {"name": "建物面積", "value": "26.84坪", "key": "buildArea", "alias": "(不含公設)", "cate": 2}, {"name": "權狀坪數", "value": "8.5坪", "key": "area_right", "alias": "", "cate": 1}, {"name": "屋齡", "value": "-", "key": "age", "alias": "", "cate": 2}, {"name": "電梯", "valu