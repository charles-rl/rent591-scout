ity": [{"key": "fridge", "active": 1, "name": "冰箱"}, {"key": "washer", "active": 1, "name": "洗衣機"}, {"key": "tv", "active": 0, "name": "電視"}, {"key": "cold", "active": 1, "name": "冷氣"}, {"key": "heater", "active": 1, "name": "熱水器"}, {"key": "bed", "active": 1, "name": "床"}, {"key": "closet", "active": 1, "name": "衣櫃"}, {"key": "fourth", "active": 1, "name": "第四台"}, {"key": "net", "active": 1, "name": "網路"}, {"key": "gas", "active": 1, "name": "天然瓦斯"}, {"key": "sofa", "active": 1, "name": "沙發"}, {"key": "table_chairs", "active": 1, "name": "桌椅"}, {"key": "balcony", "active": 1, "name": "陽台"}, {"key": "lift", "active": 0, "name": "電梯"}, {"key": "park", "active": 0, "name": "車位"}], "notice": [{"key": "leaseTime", "name": "最短一年"}]}, "preference": {"title": "優選理由", "active": 0, "footnote": "", "data": []}, "remark": {"title": "屋況介紹", "key": "remark", "active": 1, "content": "<p dir=\"auto\"><span style=\"font-size: 16px;\">🐈開放寵物貓咪🐈<br>【地點】蘆洲抽水站附近&nbsp;<br>【樓層】6F（樓梯不用管理費）<br>【能源費】水、電、瓦斯、飲水機、居家清潔室友均攤<br>【租期】一年起<br>【押金】2個月<br>【可入住日期】隨時<br>【房型】套房、雅房<br>【租金】套房12000兩年約&nbsp;/13000一年約</span><br><span style=\"font-size: 16px;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br>【優惠】當日下定，免租金二星期<br><br><br>【&nbsp;優點】<br>🍨廚房/廚房/客廳共用，反而讓房內空間更大<br>🍨有洗脫烘，還有洗衣機，要晾要烘都可以<br>🍨能源費水/電/瓦斯帳單分算繳才划算<br>🍨本房為「雙人床」<br>🍨Ubike/汽車停車場就在樓下<br><br>廁所/廚房/客廳設備完整，使用空間大，可以窩在房內，也可以在客廳喝咖啡、上網辦公<br><br>如果你想要住到CP值高、多元的空間，會遵守公用空間不使用時保持淨空，每天回家有民宿的品質，歡迎來看房<br><br>誠徵<br>#生活守則能遵守者<br>#性別友善男女都可<br><br>「共享」是品質提升的指標，（像：Uber共享自家車/foodpanda共享送餐物流系統）我們一起共享餐廳+客廳+陽台設備<br><br>大家一起分享一個家庭式的空間<br><br>💥💥住得長久舒服，最重要的關鍵是<br>1.定期居家清潔打掃共用空間<br>2.自己負責自己的垃圾，不用排值日生，你我的互動只剩美好<br>3.共用空間不堆放自己的物品<br>4.管理好自己就擁有舒服的居住環境，我們一起實現「自律就能自由」的境界<br><br>💥💥自我確認是否合適此套房<br>1.願意不計較小錢，知道台電/水/瓦斯等帳單比套房的獨立電表划算許多<br>2.使用完看廚房/客廳能隨手淨空保持乾淨<br>4.想試試斷捨離的生活方式，公共空間讓你試<br>5.想試試相遇的其他人會碰出什麼生命中的火花，期待與您相遇<br><br><br>#長安路&nbsp;#蘆洲站&nbsp;#蘆洲區&nbsp;&nbsp;#傳統廚房&nbsp;#開車族最愛&nbsp;#旁邊就是停車</span></p>\r\n附近有便利商店、傳統市場、公園綠地、學校、醫療機構、夜市。"}, "su