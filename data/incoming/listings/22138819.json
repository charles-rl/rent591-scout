場、百貨公司、公園綠地、學校、醫療機構、夜市。\r\n本房屋近三重國小捷運站。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "三重區三和路三段83巷", "lat": "25.0731446", "lng": "121.4976924", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "subway", "name": "三重國小站", "distance": 292, "distanceTxt": "距房屋約292公尺"}, {"type": "bus", "name": "仁愛街口站", "distance": 39, "distanceTxt": "距房屋約39公尺"}, {"type": "bus", "name": "崇德社區[新巴士]站", "distance": 196, "distanceTxt": "距房屋約196公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "restaurant", "name": "北港生炒羊肉", "distance": 28, "distanceTxt": "距房屋約28公尺"}, {"type": "shop", "name": "珂珂瑪物聯網", "distance": 865, "distanceTxt": "距房屋約865公尺"}]}, {"name": "教育", "key": "education", "children": [{"type": "primary", "name": "新北市三重區三重國民小學", "distance": 351, "distanceTxt": "距房屋約351公尺"}, {"type": "secondary", "name": "新北市三重區光榮國民中學", "distance": 374, "distanceTxt": "距房屋約374公尺"}]}]}, "cost": {"title": "費用詳情", "active": 1, "data": [{"name": "租金", "value": "15,000元/月", "key": "rentPrice"}, {"name": "押金", "value": "二個月", "key": "deposit"}, {"name": "租金含", "value": "管理費、網路、第四台、清潔費", "key": "priceContainText"}]}, "information": {"title": "基礎資料", "active": 1, "data": [{"name": "產權登記", "value": "房屋未辦產權登記", "key": "hasCertificate", "alias": "", "cate": 1}, {"name": "可使用面積", "value": "7坪", "key": "area", "alias": "", "cate": 1}, {"name": "屋齡", "value": "-", "key": "age", "alias": "", "cate": 2}, {"name": "電梯", "value": "無", "key": "lift", "alias": "", "cate": 1}, {"name": "裝潢程度", "value": "中檔裝潢", "key": "decorate", "alias": "", "cate": 2}, {"name": "裝潢時間", "value": "三年內", "key": "decorate_time", "alias": "", "cate": 2}, {"name": "其他特色", "value": "近捷運、新上架、拎包入住、近商圈、隨時可遷入", "key": "tags", "alias": "", "cate": 2}]}, "linkInfo": {"avatar": "https://images.591.com.tw/index/medium/no-photo-new.png", "chargeTxt": "", "name": "蘇先生", "role": 2, "roleName": "代理人", "roleTxt": "代理人", "certificateStatus": 0, "certificateTxt": "", "line": "", "imUid": 1029763, "imName