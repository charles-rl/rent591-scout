ue": "-", "key": "age", "cate": 2, "help": "", "alias": ""}]}, "service": {"title": "提供設備", "active": 1, "facility": [{"key": "fridge", "active": 1, "name": "冰箱"}, {"key": "washer", "active": 1, "name": "洗衣機"}, {"key": "tv", "active": 1, "name": "電視"}, {"key": "cold", "active": 1, "name": "冷氣"}, {"key": "heater", "active": 1, "name": "熱水器"}, {"key": "bed", "active": 1, "name": "床"}, {"key": "closet", "active": 1, "name": "衣櫃"}, {"key": "fourth", "active": 0, "name": "第四台"}, {"key": "net", "active": 1, "name": "網路"}, {"key": "gas", "active": 0, "name": "天然瓦斯"}, {"key": "sofa", "active": 0, "name": "沙發"}, {"key": "table_chairs", "active": 1, "name": "桌椅"}, {"key": "balcony", "active": 0, "name": "陽台"}, {"key": "lift", "active": 0, "name": "電梯"}, {"key": "park", "active": 0, "name": "車位"}], "notice": [{"key": "leaseTime", "name": "最短一年"}, {"key": "pet", "name": "不可養寵物"}, {"key": "cook", "name": "不可開伙"}]}, "preference": {"title": "優選理由", "active": 0, "footnote": "", "data": []}, "remark": {"title": "屋主說", "key": "remark", "active": 1, "content": "<b><span style=\"color:black;\">極新！【重陽橋】節能省電美套房，獨立洗衣機，易停車<br /><br /></span></b><span style=\"color:black;\">★</span><span style=\"font-family:新細明體;\"><span style=\"color:black;\">租屋類型：套房</span></span><br /><br /><span style=\"color:black;\">★</span><span style=\"font-family:新細明體;\"><span style=\"color:black;\">房屋類型：透天厝，總樓層四樓，每樓兩戶，全棟均為我們自有</span></span><br /><br /><span style=\"color:black;\">★</span><span style=\"font-family:新細明體;\"><span style=\"color:black;\">巷寬：大門巷寬八米，車輛易進出，採光明亮</span></span><br /><br /><span style=\"color:black;\">★</span><span style=\"color:black;\"><span style=\"font-family:新細明體;\">省電：選用億光</span></span><span style=\"color:black;\">LED&nbsp;8W</span><span style=\"color:black;\"><span style=\"font-family:新細明體;\">嵌燈，及日本</span></span><span style=\"color:black;\">SHARP</span><span style=\"font-family:新細明體;\"><span style=\"color:black;\">變頻式冷氣，在高電價年代省下寶貴的電費</span></span><br /><br /><span style=\"color:black;\">★</span><span style=\"color:black;\"><span style=\"font-family:新細明體;\">裝潢特色：實木衣櫃、化粧桌，給您自然無壓力的感受。間接照明</span></span><span style=\"color:black;\">&nbsp;/&nbsp;</span><span style=\"font-family:新細明體;\"><span style=\"color:black;\">嵌燈照明各有獨立開關，可以自由選擇照明氣氛。</span></span><br /><br /><span style=\"color:black;\">★</span><span style=\"color:black;\"><span style=\"font-family:新細明體;\">安全特色：硫化銅門、刷卡門禁、公共走道監視攝影、標準紅磚牆隔間、滅火器，消防安全無虞，隔音一級棒，住得安心。<br /><br /></span></span><span style=\"color:black;\">★</span><span style=\"color:black;\"><span style=\"font-family:新細明體;\">房屋設備：每一間都是獨立電表，</span></span><span style=\"color:black;\">8</span><span style=\"color:black;\"><span style=\"font-family:新細明體;\">加崙儲熱式熱水器、雙門冰箱、</span></span><span style=\"color:black;\">LED</span><span style=\"font-family:新細明體;\"><span style=\"color:black;\">液晶電視、分離式冷氣機。不必擔心水壓不夠洗冷水。</span></span><br /><br /><span style=\"color:black;\">★</span><span style=\"font-family:新細明體;\"><span style=\"color:black;\">交通：臨近重陽橋，環河快速路，交通方便</span></span><br /><br /><span style=\"color:black;\">★</span><span style=\"color:black;\"><span style=\"font-family:新細明體;\">公車：</span></span><span style=\"color:black;\">62,&nbsp;226,&nbsp;508,&nbsp;</span><span style=\"color:black;\"><span style=\"font-family:新細明體;\">橘</span></span><span style=\"color:black;\">18</span><br /><br /><span style=\"color:black;\">★</span><span style=\"font-family:新細明體;\"><span style=\"color:black;\">停車：巷內有五常公園地下坡平停車場，五華街及仁義街尚有多處民間停車場，停車方便</span></span><br /><br /><span style=\"color:black;\">★</span><span style=\"font-family:新細明體;\"><span style=\"color:black;\">採光通風：均有對外窗，採光通風良好</span></span><br /><br /><span style=\"color:black;\">★</span><span style=\"font-family:新細明體;\"><span style=\"color:black;\">洗衣機：每間套房均有獨立洗衣機</span></span><br /><br /><span style=\"color:black;\">★</span><span style=\"color:black;\"><span style=\"font-family:新細明體;\">網路：中華電信光世代</span></span><span style=\"color:black;\">50M</span><span style=\"font-family:新細明體;\"><span style=\"color:black;\">寬頻網路</span></span><br /><br /><span style=\"color:black;\">★</span><span style=\"color:black;\"><span style=\"font-family:新細明體;\">租金</span></span><span style=\"color:black;\">/</span><span style=\"color:black;\"><span style=\"font-family:新細明體;\">租約說明：月租</span></span><b><span style=\"color:black;\">11,000</span><span style=\"color:black;\">元</span></b><span style=\"color:black;\"><span style=\"font-family:新細明體;\">，押金</span></span><b><span style=\"color:black;\">2</span><span style=\"color:black;\">個月</span></b><span style=\"font-family:新細明體;\"><span style=\"color:black;\">，<b>一年約</b></span>。</span><br /><br /><span style=\"color:black;\">★</span><span style=\"font-family:新細明體;\"><span style=\"color:black;\">房租除了電費之外均已經包括，無其他費用，不會巧立名目加收其他費用。</span></span><br /><br /><span style=\"color:black;\">★</span><span style=\"color:black;\"><span style=\"font-family:新細明體;\">聯絡方式：看屋請先來電預約，</span></span><b><span style=\"color:black;\">0939&nbsp;–&nbsp;882213</span><span style=\"color:black;\">許先生</span></b><br /><br /><span style=\"color:black;\">★</span><span style=\"color:black;\"><span style=\"font-family:新細明體;\">地址：新北市三重區五華街</span></span><span style=\"color:black;\">7</span><span style=\"color:black;\"><span style=\"font-family:新細明體;\">巷</span></span><span style=\"color:black;\">5</span><span style=\"font-family:新細明體;\"><span style=\"color:black;\">號</span></span><br /><br /><span style=\"color:black;\">★</span><span style=\"font-family:新細明體;\"><span style=\"color:black;\">禁止事項：抽菸、養寵物、吸毒或其他犯罪行為</span></span><br /><br /><span style=\"color:black;\">★</span><span style=\"color:black;\"><span style=\"font-family:新細明體;\">特約事項：房客需提供正職證明</span></span>\r\n附近有便利商店、公園綠地、學校。\r\n本房屋近五華街公車站、碧華國中公車站。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "三重區五華街7巷5號", "lat": "25.0800360", "lng": "121.4954730", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "bus", "name": "五常公園[新巴士]站", "distance": 77, "distanceTxt": "距房屋約77公尺"}, {"type": "bus", "name": "仁愛街3