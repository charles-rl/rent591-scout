": [{"key": "leaseTime", "name": "最短一年"}, {"key": "degree", "name": "上班族"}, {"key": "pet", "name": "不可養寵物"}, {"key": "cook", "name": "不可開伙"}]}, "preference": {"title": "優選理由", "active": 0, "footnote": "", "data": []}, "remark": {"title": "屋主說", "key": "remark", "active": 1, "content": "<p dir=\"auto\"><span style=\"font-size: 18px;\"><strong>徐匯捷運5分鐘&nbsp;◆&nbsp;新建大樓3米2挑高◆入住新厝</strong></span><br><br>(太陽能熱水器+飲水機=每月最少省$:500元)<br><br>~嚴禁吸菸~<br>房內配備:全新冷氣、液晶電視、個人冰箱、溫馨床組、時尚書桌椅、個人衣櫃、中華電信100M網路.<br>★★多項免費：&nbsp;免水費、免管理費、免費洗衣服、免費網路上網、飲水機&nbsp;★★<br><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;~~全新挑高樓房、採水泥隔間、要租要快&nbsp;~~&nbsp;<br><br>房間大型對外窗(還有曬衣空間),光線及通風一極棒<br><br>肯德基、麥當勞、幸福影城&nbsp;、星巴克、全聯、徐匯廣場<br><br>◆租金//租約說明&nbsp;：租金一個月&nbsp;/&nbsp;押金為兩個月&nbsp;(只限不吸煙/正當職業人士租住)&nbsp;無小孩.&nbsp;無寵物.&nbsp;愛乾淨.無不良嗜好,<br><br>**需本人身份影本，為了安全起見，攜帶身份證正本對照**<br><br>獨立門戶磁卡進出、走道24H監視錄影<br><br>徐匯中學捷運站5分鐘、公車站2分鐘、市場、公園綠地、幸福影城、肯德基、麥當勞、玉山銀行就在巷口，生活機能非常好<br>公車有:11、221、225、229、232、264&nbsp;、815、857<br>926、925、931、306、39、508、&nbsp;662、704、659、藍1、橘18.......<br><br>溫馨提示:&nbsp;<br>★★&nbsp;房東由:刑警隊長&nbsp;、律師&nbsp;、調查局幹員等幾個房東出資經營&nbsp;★★<br>1.不得聚賭、&nbsp;吸毒嗑藥&nbsp;一發現報警給房東當業績並以違約論處沒收押金<br>2.不得糾眾喝酒、禁養寵物&nbsp;、嚴禁抽菸嚼檳榔或房間內吵架<br>3.入住者若經管區查詢有犯罪記錄一律無條件退租<br>4.以上限制敬請見諒!&nbsp;<br><br>歡迎來電看屋</p>\r\n附近有便利商店、傳統市場、百貨公司、公園綠地、學校、醫療機構、夜市。\r\n本房屋近幸福戲院公車站、徐匯中學公車站、民權西路公車站、南京松江捷運站、行天宮捷運站、三和國中捷運站、台北火車站。"}, "surround": {"title": "周邊配套", "key": "surround", "active": 1, "address": "三重區三和路四段", "lat": "25.0791759", "lng": "121.4819562", "data": [{"name": "交通", "key": "traffic", "children": [{"type": "subway", "name": "徐匯中學站", "distance": 244, "distanceTxt": "距房屋約244公尺"}, {"type": "subway", "name": "三和國中站", "distance": 522, "distanceTxt": "距房屋約522公尺"}, {"type": "bus", "name": "徐匯中學站", "distance": 64, "distanceTxt": "距房屋約64公尺"}]}, {"name": "生活", "key": "live", "children": [{"type": "shop", "name": "橡木桶